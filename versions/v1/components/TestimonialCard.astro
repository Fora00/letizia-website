---
interface Props {
  quote: string;
  author: string;
  stars?: number;
  context?: string;
}

const { quote, author, stars, context } = Astro.props;
const starArray = stars !== undefined ? Array.from({ length: 5 }, (_, i) => i < stars) : null;
---

<article class="bg-sage-light dark:bg-sage-dark rounded-2xl p-8 relative transition-colors duration-200">
  <svg class="absolute top-4 left-4 w-10 h-10 text-sage dark:text-accent-dark opacity-50" fill="currentColor" viewBox="0 0 24 24">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
  </svg>
  {starArray && (
    <div class="flex gap-0.5 mb-3 pt-8">
      {starArray.map((filled) => (
        <svg class={`w-4 h-4 ${filled ? 'text-accent dark:text-accent-dark' : 'text-navy/20'}`} fill="currentColor" viewBox="0 0 24 24">
          <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
      ))}
    </div>
  )}
  <blockquote class:list={["text-navy/80 dark:text-text-dark/80 leading-relaxed mb-6 normal-case", !starArray && "pt-8"]}>
    {quote}
  </blockquote>
  <footer class="font-heading font-semibold text-accent dark:text-accent-dark">
    — {author}
  </footer>
  {context && (
    <p class="text-xs uppercase tracking-wide text-navy/50 dark:text-text-dark/50 mt-2">{context}</p>
  )}
</article>
