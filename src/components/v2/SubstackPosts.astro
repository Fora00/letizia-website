---
import allPosts from '../../data/newsletter-posts.json';

const SUBSTACK_URL = "https://tadamove.substack.com";

interface Props {
  limit?: number;
  showAllLink?: boolean;
}
const { limit = 3, showAllLink = false } = Astro.props;

const posts = allPosts.slice(0, limit);
---

{posts.length > 0 && (
  <div>
    <div class="grid md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a
          href={post.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col bg-white dark:bg-surface-dark rounded-2xl shadow-sm border border-sage/30 dark:border-sage-dark/30 overflow-hidden hover:shadow-md transition-shadow"
        >
          {post.image && (
            <div class="aspect-video overflow-hidden bg-sage-light dark:bg-sage-dark">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          )}
          <div class="flex flex-col flex-1 p-5">
            {post.date && (
              <p class="text-xs text-navy/40 dark:text-text-dark/40 mb-2">{post.date}</p>
            )}
            <h3 class="font-heading font-semibold text-navy dark:text-text-dark mb-3 leading-snug group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
              {post.title}
            </h3>
            <p class="text-sm text-navy/70 dark:text-text-dark/70 leading-relaxed flex-1">
              {post.description}
            </p>
            <span class="mt-4 text-sm text-accent dark:text-accent-dark font-semibold">
              Leggi →
            </span>
          </div>
        </a>
      ))}
    </div>

    {showAllLink && (
      <div class="text-center mt-8">
        <a
          href={SUBSTACK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent dark:text-accent-dark font-semibold hover:underline"
        >
          Leggi tutti gli articoli su Substack →
        </a>
      </div>
    )}
  </div>
)}
