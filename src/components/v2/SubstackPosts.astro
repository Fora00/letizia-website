---
import allPosts from '../../data/newsletter-posts.json';

import { parsePath, useTranslations } from '../../i18n/utils';

const { lang } = parsePath(Astro.url.pathname);
const t = useTranslations(lang);

const SUBSTACK_URL = "https://tadamove.substack.com";

interface Props {
  /** How many posts to show; omit `limit` on archive pages to show them all */
  limit?: number;
  showAllLink?: boolean;
}
const { limit, showAllLink = false } = Astro.props;

const posts = limit == null ? allPosts : allPosts.slice(0, limit);
---

{posts.length > 0 && (
  <div>
    <div class="grid md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a
          href={post.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col bg-page dark:bg-surface-dark rounded-2xl shadow-sm border border-sage/30 dark:border-sage-dark/30 overflow-hidden hover:shadow-md transition-shadow"
        >
          {post.image && (
            <div class="aspect-video overflow-hidden bg-sage-light dark:bg-sage-dark">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          )}
          <div class="flex flex-col flex-1 p-5">
            {post.date && (
              <p class="text-xs text-navy/40 dark:text-text-dark/40 mb-2">{post.date}{lang !== 'it' && ` · ${t('shared.posts.original_italian')}`}</p>
            )}
            <h3 class="font-heading font-semibold text-navy dark:text-text-dark mb-3 leading-snug group-hover:text-accent-text dark:group-hover:text-accent-dark transition-colors">
              {post.title}
            </h3>
            <p class="text-sm text-navy/70 dark:text-text-dark/70 leading-relaxed flex-1">
              {post.description}
            </p>
            <span class="mt-4 text-sm text-accent-text dark:text-accent-dark font-semibold">
              {t('shared.posts.read')}
            </span>
          </div>
        </a>
      ))}
    </div>

    {showAllLink && (
      <div class="text-center mt-8">
        <a
          href={SUBSTACK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent-text dark:text-accent-dark font-semibold hover:underline"
        >
          {t('shared.posts.read_all')}
        </a>
      </div>
    )}
  </div>
)}
