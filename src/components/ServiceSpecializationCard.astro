---
interface Props {
  title: string;
  description: string;
  icon: string;
  badge?: string;
  href?: string;
}

const { title, description, icon, badge, href } = Astro.props;
---

<article class="relative bg-white dark:bg-sage-dark rounded-2xl p-6 shadow-md dark:shadow-none transition-all duration-200 border border-sage/20 dark:border-white/10 border-l-4 border-l-accent hover:-translate-y-1 hover:shadow-lg">
  {badge && (
    <span class="absolute top-4 right-4 bg-accent/10 dark:bg-accent-dark/20 text-accent dark:text-accent-dark text-xs font-semibold px-3 py-1 rounded-full">
      {badge}
    </span>
  )}
  {icon && (
    <div class="w-14 h-14 bg-sage-light dark:bg-navy-dark rounded-xl flex items-center justify-center mb-4">
      <Fragment set:html={icon} />
    </div>
  )}
  <h3 class="font-heading font-semibold text-xl text-navy dark:text-text-dark mb-3">{title}</h3>
  <p class="text-navy/70 dark:text-text-dark/70 leading-relaxed">{description}</p>
  {href && (
    <a href={href} class="mt-4 inline-block text-sm text-accent dark:text-accent-dark font-semibold hover:underline">
      Scopri di più →
    </a>
  )}
</article>
