---
const version = Astro.url.pathname.split('/').find(s => /^\d+$/.test(s)) ?? '';
const base = `${import.meta.env.BASE_URL}${version}`;

const leftNavItems = [
  { href: `${base}/`, label: 'Home', icon: 'home' },
  { href: `${base}/chi-sono`, label: 'Chi sono', icon: 'user' },
  { href: `${base}/cosa-offro`, label: 'Cosa offro', icon: 'briefcase' },
];

const contactItem = { href: `${base}/contatti`, label: 'Contatti', icon: 'mail' };

const allNavItems = [...leftNavItems, contactItem];

const currentPath = Astro.url.pathname;
---

<header class="bg-white dark:bg-navy-dark shadow-sm dark:shadow-none dark:border-b dark:border-white/10 sticky top-0 z-50 transition-colors duration-200">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Left nav (desktop) -->
      <ul class="hidden md:flex items-center gap-5">
        <li>
          <a href={import.meta.env.BASE_URL} class="flex items-center gap-1.5 font-medium text-sm text-navy/40 dark:text-text-dark/40 hover:text-accent dark:hover:text-accent-dark transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Versioni
          </a>
        </li>
        <!-- LM Logo -->
        <li class="flex items-center">
          <img
            src={`${import.meta.env.BASE_URL}images/logo-lm.png`}
            alt="Logo LM"
            class="h-6 w-auto block dark:hidden"
          />
          <img
            src={`${import.meta.env.BASE_URL}images/logo-lm-dark.png`}
            alt="Logo LM"
            class="h-6 w-auto hidden dark:block"
          />
        </li>
        {leftNavItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-1.5 font-medium text-sm hover:text-accent transition-colors",
                currentPath === item.href ? "text-accent dark:text-accent-dark" : "text-navy dark:text-text-dark"
              ]}
            >
              {item.icon === 'home' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
              )}
              {item.icon === 'user' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              )}
              {item.icon === 'briefcase' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {item.icon === 'mail' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg hover:bg-sage-light dark:hover:bg-surface-dark transition-colors"
        aria-label="Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Mobile logo (center) -->
      <div class="md:hidden absolute left-1/2 -translate-x-1/2">
        <img src={`${import.meta.env.BASE_URL}images/logo-lm.png`} alt="Logo LM" class="h-6 w-auto block dark:hidden" />
        <img src={`${import.meta.env.BASE_URL}images/logo-lm-dark.png`} alt="Logo LM" class="h-6 w-auto hidden dark:block" />
      </div>

      <!-- Right nav — Contatti + Dark mode toggle (desktop) -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={contactItem.href}
          class:list={[
            "flex items-center gap-1.5 font-medium text-sm px-4 py-2 rounded-full transition-colors",
            currentPath === contactItem.href
              ? "bg-accent dark:bg-accent-dark text-white dark:text-navy-dark"
              : "bg-sage-light dark:bg-sage-dark text-navy dark:text-text-dark hover:bg-sage hover:text-white dark:hover:bg-accent-dark dark:hover:text-navy-dark"
          ]}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {contactItem.label}
        </a>
        <button
          id="theme-toggle-desktop"
          class="p-2 rounded-lg hover:bg-sage-light dark:hover:bg-surface-dark transition-colors"
          aria-label="Attiva/disattiva tema scuro"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 space-y-2">
      <ul class="space-y-2">
        <li>
          <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 py-2 px-4 rounded-lg font-medium text-navy/40 dark:text-text-dark/40 hover:bg-sage-light dark:hover:bg-surface-dark transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Versioni
          </a>
        </li>
        {allNavItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-2 py-2 px-4 rounded-lg font-medium hover:bg-sage-light dark:hover:bg-surface-dark transition-colors",
                currentPath === item.href ? "text-accent dark:text-accent-dark bg-sage-light dark:bg-surface-dark" : "text-navy dark:text-text-dark"
              ]}
            >
              {item.icon === 'home' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
              )}
              {item.icon === 'user' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              )}
              {item.icon === 'briefcase' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {item.icon === 'mail' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex justify-end pt-2 border-t border-sage/20 dark:border-white/10 mt-2">
        <button
          id="theme-toggle-mobile"
          class="p-2 rounded-lg hover:bg-sage-light dark:hover:bg-surface-dark transition-colors"
          aria-label="Attiva/disattiva tema scuro"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
