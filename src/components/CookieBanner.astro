---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-50 bg-navy dark:bg-navy-dark border-t border-white/10 shadow-lg"
  role="dialog"
  aria-label="Informativa cookie"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center gap-4">
    <p class="flex-1 text-sm text-white/80 leading-relaxed">
      Questo sito non usa cookie di profilazione: salva solo preferenze tecniche (come il tema) sul tuo dispositivo. I servizi di terze parti (Calendly, Tally, Substack) potrebbero impostare cookie propri quando interagisci con loro.
      <a href={`${base}/privacy`} class="underline opacity-70 hover:opacity-100 ml-1">Informativa completa</a>
    </p>
    <button
      id="cookie-accept"
      class="shrink-0 bg-accent dark:bg-accent-dark text-white dark:text-navy font-semibold px-6 py-2.5 rounded-full text-sm hover:opacity-90 transition-opacity"
    >
      Ho capito
    </button>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  if (localStorage.getItem('cookie-ok')) {
    banner?.remove();
  } else if (banner) {
    // Reserve space so the banner never hides page content or the
    // back-to-top button on small viewports
    const pad = () => {
      document.body.style.paddingBottom = `${banner.offsetHeight}px`;
    };
    pad();
    window.addEventListener('resize', pad);
    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      localStorage.setItem('cookie-ok', '1');
      window.removeEventListener('resize', pad);
      document.body.style.paddingBottom = '';
      banner.remove();
    });
  }
</script>
