---
interface Props {
  title: string;
  subtitle?: string;
  showCta?: boolean;
  ctaText?: string;
  ctaHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  subtitle,
  showCta = false,
  ctaText = "Contattami",
  ctaHref = "/contatti",
  imageSrc,
  imageAlt = "Letizia Mancini",
} = Astro.props;
---

<section class="relative bg-sage-light dark:bg-surface-dark overflow-hidden transition-colors duration-200">
  {/* Fixed profile image - always at bottom right of the page */}
  {imageSrc && (
    <div class="fixed bottom-0 right-0 z-50 pointer-events-none">
      <a
        href={`${base}/chi-sono`}
        class="block group pointer-events-auto"
      >
        <img
          src={imageSrc}
          alt={imageAlt}
          class="h-48 sm:h-64 md:h-80 w-auto object-cover rounded-t-2xl transition-transform group-hover:scale-105 origin-bottom"
        />
      </a>
    </div>
  )}

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class={imageSrc ? "grid md:grid-cols-2 gap-12" : ""}>
      <div>
        <h1 class="font-heading font-bold text-4xl md:text-5xl lg:text-6xl text-navy dark:text-text-dark mb-6 leading-tight">
          {title}
        </h1>
        {subtitle && (
          <p class="text-lg md:text-xl text-navy/80 dark:text-text-dark/80 mb-8 leading-relaxed">
            {subtitle}
          </p>
        )}
        {showCta && (
          <a
            href={ctaHref}
            class="inline-block bg-accent dark:bg-accent-dark text-white dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy dark:hover:bg-text-dark transition-colors"
          >
            {ctaText}
          </a>
        )}
      </div>
      {/* Right column intentionally empty — fixed image fills this space visually */}
      {imageSrc && <div />}
    </div>
  </div>
</section>
