---
import Layout from '../layouts/LayoutV5.astro';
import Section from '../components/v5/Section.astro';
import { Image } from 'astro:assets';
import studioImgSrc from '../assets/images/studio-chinesiologia-allenamento.jpg';
import { social } from '../constants/socials';
import { locations } from '../constants/locations';
import SubstackSignup from '../components/v2/SubstackSignup.astro';
import { parsePath, useTranslations, localizedHref } from '../i18n/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { lang } = parsePath(Astro.url.pathname);
const t = useTranslations(lang);

---

<Layout lang={lang} title={t('contact.meta.title')} description={t('contact.meta.description')}>
  <!-- Page header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-page dark:bg-navy-dark text-accent-text dark:text-accent-dark font-semibold px-4 py-1.5 rounded-full text-sm mb-4">
        {t('contact.header.badge')}
      </span>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        {t('contact.header.title')}
      </h1>
      <p class="text-lg text-navy/70 dark:text-text-dark/70 max-w-2xl leading-relaxed">
        {t('contact.header.subtitle')}
      </p>
    </div>
  </section>

  <!-- Form + info -->
  <Section>
    <div class="grid lg:grid-cols-5 gap-12">
      <!-- Contact Form -->
      <div class="lg:col-span-3">
        <div class="bg-sage-light dark:bg-surface-dark rounded-2xl p-8 transition-colors duration-200">
          <h2 class="font-heading font-semibold text-2xl text-navy dark:text-text-dark mb-6">
            {t('contact.form.title')}
          </h2>
          <iframe
            src={`https://tally.so/embed/3yxDLp?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
            loading="lazy"
            width="100%"
            height="300"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title={t('contact.form.iframe_title')}
            class="rounded-lg"
            style="min-height:400px"
          ></iframe>
          <noscript>
            <p class="text-navy/70 dark:text-text-dark/70">
              {t('contact.form.noscript_1')}
              {t('contact.form.noscript_2')} <a href={`mailto:${social.mail}`} class="text-accent-text dark:text-accent-dark hover:underline">{social.mail}</a>
            </p>
          </noscript>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Calendly Booking -->
        <a
          href="https://calendly.com/letiziamancini-chinesiologa/prenota_gratis?share_attribution=send_from_calendly_et_card"
          target="_blank"
          rel="noopener noreferrer"
          class="plausible-event-name=prenota-consulenza block bg-accent dark:bg-accent-dark text-navy dark:text-navy-dark rounded-2xl p-6 shadow-md dark:shadow-none hover:bg-navy hover:text-white dark:hover:bg-text-dark transition-colors group"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white/20 dark:bg-navy-dark/15 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-heading font-semibold text-lg mb-0.5">
                {t('contact.booking.title')}
              </h3>
              <p class="text-white/80 dark:text-navy-dark/70 text-sm">
                {t('contact.booking.text')}
              </p>
            </div>
            <svg class="w-5 h-5 ml-auto group-hover:translate-x-1 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>

        <!-- Contact details -->
        <div class="bg-sage-light dark:bg-surface-dark rounded-2xl p-6 transition-colors duration-200">
          <h3 class="font-heading font-semibold text-xl text-navy dark:text-text-dark mb-5">
            {t('contact.info.title')}
          </h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 bg-page dark:bg-navy-dark rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-accent-text dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-navy dark:text-text-dark text-sm">{t('contact.info.email')}</p>
                <a href={`mailto:${social.mail}`} class="text-accent-text dark:text-accent-dark hover:underline text-sm">
                  {social.mail}
                </a>
              </div>
            </li>
            {locations.map((place) => (
              <li class="flex items-start gap-3">
                <div class="w-9 h-9 bg-page dark:bg-navy-dark rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-accent-text dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer">
                  <p class="font-medium text-navy dark:text-text-dark text-sm">{place.city}</p>
                  <p class="text-navy/70 dark:text-text-dark/70 text-sm">
                    {place.venue ? `${place.venue}, ` : ''}{place.street} — {t('contact.info.by_appointment')}
                  </p>
                </a>
              </li>
            ))}
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 bg-page dark:bg-navy-dark rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-accent-text dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-navy dark:text-text-dark text-sm">{t('contact.info.online')}</p>
                <p class="text-navy/70 dark:text-text-dark/70 text-sm">{t('contact.info.online_text')}</p>
              </div>
            </li>
          </ul>
          <a
            href={`${base}/letizia-mancini.vcf`}
            download="letizia-mancini.vcf"
            class="mt-6 inline-flex items-center gap-2 bg-page dark:bg-navy-dark text-accent-text dark:text-accent-dark font-semibold text-sm px-5 py-2.5 rounded-full hover:bg-accent hover:text-navy dark:hover:bg-accent-dark dark:hover:text-navy-dark transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {t('contact.info.save_contact')}
          </a>
        </div>
      </div>
    </div>
  </Section>



  <!-- Newsletter signup -->
  <Section centered>
    <SubstackSignup showPostsLink={true} />
  </Section>
</Layout>
