---
import Layout from '../layouts/LayoutV5.astro';
import Section from '../components/v5/Section.astro';
import { Image } from 'astro:assets';
import aboutImgSrc from '../assets/images/letizia-mancini-chinesiologa-studio.jpg';
import { parsePath, useTranslations, localizedHref } from '../i18n/utils';

const { lang } = parsePath(Astro.url.pathname);
const t = useTranslations(lang);

const icons = [
  "M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222",
  "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
  "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
];
const dates = ["2021", "2023", "2024", "2026"];
const formation: any[] = t.group('about.formation.items').map((item: any, i: number) => ({ ...item, iconPath: icons[i], date: dates[i] }));
---

<Layout title={t('about.meta.title')} description={t('about.meta.description')} lang={lang}>
  <!-- Page header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-page dark:bg-navy-dark text-accent-text dark:text-accent-dark font-semibold px-4 py-1.5 rounded-full text-sm mb-4">
        {t('about.header.badge')}
      </span>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        {t('about.header.title')}
      </h1>
      <p class="text-lg text-navy/70 dark:text-text-dark/70 max-w-2xl leading-relaxed">
        {t('about.header.subtitle')}
      </p>
    </div>
  </section>

  <!-- Bio -->
  <Section>
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="fade-in-up space-y-4 text-navy/80 dark:text-text-dark/80 leading-relaxed">
        <p set:html={t('about.bio.p1')} />
        <p set:html={t('about.bio.p2')} />
        <p set:html={t('about.bio.p3')} />
        <p set:html={t('about.bio.p4')} />
      </div>
      <div class="fade-in-up flex justify-center" style="transition-delay: 150ms">
        <Image
          src={aboutImgSrc}
          alt={t('about.bio.image_alt')}
          width={640}
          height={800}
          loading="lazy"
          class="w-80 h-auto max-h-[32rem] object-cover rounded-2xl shadow-xl"
        />
      </div>
    </div>
  </Section>

  <!-- Formazione -->
  <Section bgColor="sage-light" title={t('about.formation.title')} centered>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
      {formation.map((item: any, i: number) => (
        <div class="fade-in-up bg-page dark:bg-navy-dark rounded-xl p-6 text-center transition-colors duration-200 flex flex-col" style={`transition-delay: ${i * 80}ms`}>
          <div class="w-14 h-14 bg-accent/10 dark:bg-accent-dark/20 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-accent-text dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.iconPath} />
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="font-heading font-semibold text-navy dark:text-text-dark mb-2">{item.title}</h3>
          </div>
          <p class="text-sm text-navy/70 dark:text-text-dark/70 mb-3">{item.sub}</p>
          <span class="inline-block text-xs text-accent-text/70 dark:text-accent-dark/70">{item.date}</span>
        </div>
      ))}
    </div>
  </Section>

  <!-- Approccio -->
  <Section>
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-6">
        {t('about.approach.title')}
      </h2>
      <p class="text-navy/80 dark:text-text-dark/80 leading-relaxed">{t('about.approach.p1')}</p>
      <p class="text-navy/80 dark:text-text-dark/80 leading-relaxed mt-4" set:html={t.html('about.approach.p2')} />
    </div>
  </Section>

  <!-- CTA finale -->
  <Section bgColor="sage-light" centered>
    <div class="max-w-xl mx-auto text-center">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-4">
        {t('about.cta.title')}
      </h2>
      <p class="text-navy/80 dark:text-text-dark/80 mb-8 leading-relaxed">
        {t('about.cta.text')}
      </p>
      <a
        href={localizedHref('/contatti', lang)}
        class="inline-block bg-accent dark:bg-accent-dark text-navy dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy hover:text-white dark:hover:bg-text-dark transition-colors"
      >
        {t('about.cta.button')}
      </a>
    </div>
  </Section>
</Layout>
