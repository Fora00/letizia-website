---
import Layout from '../layouts/LayoutV5.astro';
import Section from '../components/v5/Section.astro';
import { social } from '../constants/socials';
import reviewsData from '../data/reviews.json';
import { parsePath, useTranslations, localizedHref } from '../i18n/utils';

const { lang } = parsePath(Astro.url.pathname);
const t = useTranslations(lang);
const fmtDate = (d: string) => new Date(d).getFullYear();

const reviews = reviewsData as { author: string; rating: number; text: string; date: string | null }[];


// Nota SEO: niente AggregateRating/Review self-serving in JSON-LD — Google ignora (e può
// penalizzare) le recensioni auto-pubblicate su LocalBusiness. Le testimonianze restano in
// HTML e rimandano alla scheda Google come fonte.
---

<Layout lang={lang} title={t('reviews.meta.title')} description={t('reviews.meta.description')}>
  <!-- Page header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-page dark:bg-navy-dark text-accent-text dark:text-accent-dark font-semibold px-4 py-1.5 rounded-full text-sm mb-4">
        {t('reviews.header.badge')}
      </span>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        {t('reviews.header.title')}
      </h1>
      <p class="text-lg text-navy/70 dark:text-text-dark/70 max-w-2xl leading-relaxed">
        {t('reviews.header.subtitle')}
      </p>
    </div>
  </section>

  <!-- Masonry testimonials -->
  <Section>
    <div class="flex flex-col sm:flex-row gap-3 mb-8" role="search">
      <label class="sr-only" for="review-search">{t('reviews.filters.search_label')}</label>
      <input id="review-search" type="search" placeholder={t('reviews.filters.search_placeholder')} class="flex-1 rounded-full border border-navy/15 dark:border-text-dark/20 bg-page dark:bg-surface-dark text-navy dark:text-text-dark px-5 py-2.5 text-sm" />
      <label class="sr-only" for="review-rating">{t('reviews.filters.rating_label')}</label>
      <select id="review-rating" class="rounded-full border border-navy/15 dark:border-text-dark/20 bg-page dark:bg-surface-dark text-navy dark:text-text-dark px-5 py-2.5 text-sm">
        <option value="0">{t('reviews.filters.all_stars')}</option>
        {[5, 4, 3, 2, 1].map((n) => <option value={n}>{n} {n === 1 ? t('reviews.filters.star_one') : t('reviews.filters.star_many')}</option>)}
      </select>
      <label class="sr-only" for="review-sort">{t('reviews.filters.sort_label')}</label>
      <select id="review-sort" class="rounded-full border border-navy/15 dark:border-text-dark/20 bg-page dark:bg-surface-dark text-navy dark:text-text-dark px-5 py-2.5 text-sm">
        <option value="recent">{t('reviews.filters.sort_recent')}</option>
        <option value="oldest">{t('reviews.filters.sort_oldest')}</option>
        <option value="high">{t('reviews.filters.sort_high')}</option>
        <option value="low">{t('reviews.filters.sort_low')}</option>
      </select>
    </div>
    <p id="review-count" data-one={t('reviews.filters.count_one')} data-many={t('reviews.filters.count_many')} class="text-sm text-navy/60 dark:text-text-dark/60 mb-4" aria-live="polite"></p>

    <div class="masonry-grid" id="review-grid">
      {reviews.map((review, i) => (
        <article
          aria-label={`${t('reviews.card.aria')} ${review.author}`}
          data-rating={review.rating}
          data-date={review.date ?? ''}
          data-index={i}
          data-text={`${review.author} ${review.text}`.toLowerCase()}
          class="masonry-item bg-sage-light dark:bg-surface-dark rounded-2xl p-6 hover:shadow-md transition-shadow duration-200"
        >
          <div class="flex gap-0.5 mb-3" aria-label={`${review.rating} ${t('reviews.card.stars_aria_suffix')}`}>
            {Array.from({ length: 5 }).map((_, n) => (
              <svg class:list={['w-4 h-4', n < review.rating ? 'fill-[#facc15]' : 'fill-navy/15 dark:fill-text-dark/20']} viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-navy/85 dark:text-text-dark/85 leading-relaxed text-base mb-5">
            {review.text}
          </p>
          <p class="font-heading font-semibold text-accent-text dark:text-accent-dark">
            &mdash; {review.author}
          </p>
          {review.date && <p class="text-xs text-navy/50 dark:text-text-dark/50 mt-1">{fmtDate(review.date)}</p>}
        </article>
      ))}
    </div>
    <p id="review-empty" class="text-center text-navy/60 dark:text-text-dark/60 py-8" hidden>{t('reviews.filters.empty')}</p>

    <p class="text-center mt-8 text-sm text-navy/60 dark:text-text-dark/60">
      {t('reviews.google_note')}
      <a href={social.maps} target="_blank" rel="noopener noreferrer" class="text-accent-text dark:text-accent-dark font-semibold hover:underline">
        {t('reviews.google_link')}
      </a>
    </p>

    <script>
      const grid = document.getElementById('review-grid')!;
      const items = Array.from(grid.querySelectorAll<HTMLElement>('article'));
      const search = document.getElementById('review-search') as HTMLInputElement;
      const rating = document.getElementById('review-rating') as HTMLSelectElement;
      const sort = document.getElementById('review-sort') as HTMLSelectElement;
      const count = document.getElementById('review-count')!;
      const empty = document.getElementById('review-empty')!;

      const num = (el: HTMLElement, k: string) => Number(el.dataset[k]);
      // Undated reviews sort last for "recent" and first for "oldest".
      const time = (el: HTMLElement) => (el.dataset.date ? Date.parse(el.dataset.date) : 0);
      const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        recent: (a, b) => time(b) - time(a) || num(a, 'index') - num(b, 'index'),
        oldest: (a, b) => time(a) - time(b) || num(a, 'index') - num(b, 'index'),
        high: (a, b) => num(b, 'rating') - num(a, 'rating') || time(b) - time(a),
        low: (a, b) => num(a, 'rating') - num(b, 'rating') || time(b) - time(a),
      };

      function update() {
        const q = search.value.trim().toLowerCase();
        const stars = Number(rating.value);
        let shown = 0;
        for (const el of [...items].sort(sorters[sort.value])) {
          const ok = (!stars || num(el, 'rating') === stars) && (!q || el.dataset.text!.includes(q));
          el.hidden = !ok;
          if (ok) shown++;
          grid.appendChild(el);
        }
        count.textContent = `${shown} ${shown === 1 ? count.dataset.one : count.dataset.many}`;
        empty.hidden = shown > 0;
      }
      [search, rating, sort].forEach((c) => c.addEventListener('input', update));
      update();
    </script>

    <style>
      .masonry-grid {
        columns: 1;
        column-gap: 1.25rem;
      }
      @media (min-width: 640px) {
        .masonry-grid { columns: 2; }
      }
      @media (min-width: 1024px) {
        .masonry-grid { columns: 3; }
      }
      .masonry-item[hidden] { display: none; }
      .masonry-item {
        break-inside: avoid;
        margin-bottom: 1.25rem;
        display: inline-block;
        width: 100%;
      }
    </style>
  </Section>

  <!-- CTA finale -->
  <Section bgColor="sage-light" centered>
    <div class="max-w-xl mx-auto text-center">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-4">
        {t('reviews.cta.title')}
      </h2>
      <p class="text-navy/80 dark:text-text-dark/80 mb-8 leading-relaxed">
        <Fragment set:html={t.html('reviews.cta.text')} />
      </p>
      <a
        href={localizedHref('/contatti', lang)}
        class="inline-block bg-accent dark:bg-accent-dark text-navy dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy hover:text-white dark:hover:bg-text-dark transition-colors"
      >
        {t('reviews.cta.button')}
      </a>
    </div>
  </Section>
</Layout>
