---
import Layout from '../../layouts/LayoutV4.astro';
import Section from '../../components/v4/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';

const version = Astro.url.pathname.split('/').find(s => /^\d+$/.test(s)) ?? '';
const base = `${import.meta.env.BASE_URL}${version}`;

const services = [
  {
    title: "Movimento adattato per condizioni croniche",
    description: "Programmi di esercizio fisico personalizzati per persone con patologie croniche stabilizzate (diabete, ipertensione, patologie cardiovascolari, ecc.).",
    icon: "💚"
  },
  {
    title: "Supporto per disturbi della nutrizione e dell'alimentazione",
    description: "Prendere consapevolezza del proprio corpo e muoversi in un contesto sicuro, guidato e senza giudizio.",
    icon: "🌱"
  },
  {
    title: "Gestione del dolore osteo-articolare",
    description: "Esercizi mirati per alleviare dolori muscolari e articolari (mal di schiena, cervicalgia, dolori alle spalle, ecc.) attraverso il movimento corretto e il rinforzo muscolare.",
    icon: "🦴"
  },
  {
    title: "Gravidanza e post-parto",
    description: "Esercizi sicuri e adattati per accompagnare ogni fase della maternità: dalla preparazione al parto al recupero post-partum.",
    icon: "🤰"
  },
  {
    title: "Terza età",
    description: "Programmi specifici per mantenere e migliorare la mobilità, l'equilibrio e l'autonomia. Prevenzione delle cadute e mantenimento della qualità di vita.",
    icon: "🌳"
  },
  {
    title: "Ricomposizione corporea",
    description: "Percorsi per chi desidera perdere peso, aumentare la massa muscolare o semplicemente migliorare la propria forma fisica in modo sano, graduale e sostenibile nel tempo.",
    icon: "⚡"
  },
];

const formats = [
  {
    title: "Lezioni individuali",
    description: "Sessioni one-to-one completamente personalizzate sui tuoi bisogni, obiettivi e stile di vita.",
    icon: "👤",
    highlight: "Massima personalizzazione",
    price: "€65",
    priceDetail: "lezione singola",
    packages: "4 lezioni €200 · 8 lezioni €370 · 12 lezioni €550",
    packagesNote: "pacchetti da usare entro 2–4 mesi"
  },
  {
    title: "Piccoli gruppi",
    description: "Allenamenti in piccoli gruppi con un ottimo equilibrio tra attenzione personalizzata e dinamiche di gruppo.",
    icon: "👥",
    highlight: "3-5 persone",
    price: "€75",
    priceDetail: "al mese (4 lezioni)",
    packages: "gruppi di 3–5 persone",
    packagesNote: "rinnovo mensile flessibile"
  },
  {
    title: "Coaching online",
    description: "Sessioni in videochiamata e scheda di allenamento personalizzata per chi è lontano o preferisce allenarsi in autonomia.",
    icon: "💻",
    highlight: "Ovunque tu sia",
    price: "€300",
    priceDetail: "semestrale (4 visite + scheda)",
    packages: "€800 annuale",
    packagesNote: "10 visite + scheda personalizzata"
  }
];

const targets: {icon: string, description: string}[] = [
  {
    description: "Cerchi un percorso costruito su misura, che tenga conto della tua storia e del tuo stile di vita per imparare a muoverti in sicurezza.",
    icon: "🪡"
  },
  {
    description: "Vuoi migliorare forza, autonomia e qualità della vita e ritrovare energia.",
    icon: "💪"
  },
  {
    description: "Vuoi allenarti in uno spazio privato, lontano dal caos della palestra.",
    icon: "🕵️"
  },
];
---

<Layout title="Cosa offro" description="Scopri i servizi di chinesiologia clinica, i formati di allenamento e come posso aiutarti: lezioni individuali, piccoli gruppi, coaching online e molto altro">
  <Section>
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-6">
        Cosa offro
      </h1>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {services.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </Section>

  <!-- Come lavoro: background image section -->
  <Section
    title="Come lavoro"
    centered
    class="relative overflow-hidden"
    style={`background-image: url('${import.meta.env.BASE_URL}images/cosa-offro.jpg'); background-size: cover; background-position: center 30%;`}
  >
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-navy/75 -z-0"></div>
    <div class="relative z-10">
      <div class="grid md:grid-cols-3 gap-6">
        {formats.map((format) => (
          <article class="bg-white/95 dark:bg-navy-dark/90 rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-200 border border-white/20 flex flex-col backdrop-blur-sm">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-14 h-14 bg-sage-light dark:bg-surface-dark rounded-xl flex items-center justify-center shrink-0">
                <span class="text-2xl">{format.icon}</span>
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h3 class="font-heading font-semibold text-lg text-navy dark:text-text-dark">
                    {format.title}
                  </h3>
                  <span class="text-xs font-medium bg-accent/10 dark:bg-accent-dark/20 text-accent dark:text-accent-dark px-2 py-0.5 rounded-full">
                    {format.highlight}
                  </span>
                </div>
                <p class="text-navy/70 dark:text-text-dark/70 leading-relaxed text-sm">
                  {format.description}
                </p>
              </div>
            </div>
            <div class="mt-auto pt-4 border-t border-sage/20 dark:border-white/10">
              <div class="flex items-baseline gap-2 mb-1">
                <span class="font-heading font-bold text-2xl text-accent dark:text-accent-dark">{format.price}</span>
                <span class="text-sm text-navy/60 dark:text-text-dark/60">{format.priceDetail}</span>
              </div>
              <p class="text-sm font-medium text-navy/80 dark:text-text-dark/80">{format.packages}</p>
              <p class="text-xs text-navy/50 dark:text-text-dark/50 mt-0.5">{format.packagesNote}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Section>

  <Section>
    <div class="text-center mb-12">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-4">
        Sei nel posto giusto se...
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {targets.map((target) => (
        <article class="bg-white dark:bg-navy-dark rounded-xl p-5 hover:shadow-md dark:shadow-none transition-all duration-200">
          <div class="flex items-center flex-col h-full justify-center gap-3">
            <div class="flex flex-row justify-center gap-3">
              <span class="text-2xl self-center">{target.icon}</span>
              <div>
                <p class="text-sm text-navy/70 self-center dark:text-text-dark/70">
                  {target.description}
                </p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section bgColor="sage-light">
    <div class="grid gap-12 items-center">
      <div>
        <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-6">
          Iniziamo?
        </h2>
        <ol class="space-y-6">
          <li class="flex gap-4">
            <span class="w-10 h-10 bg-accent dark:bg-accent-dark text-white dark:text-navy-dark rounded-full flex items-center justify-center font-bold shrink-0">1</span>
            <div>
              <h3 class="font-semibold text-navy dark:text-text-dark mb-1">Contattami</h3>
              <p class="text-navy/70 dark:text-text-dark/70">Raccontami la tua situazione e i tuoi obiettivi via form, email o prenota una call gratuita.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="w-10 h-10 bg-accent dark:bg-accent-dark text-white dark:text-navy-dark rounded-full flex items-center justify-center font-bold shrink-0">2</span>
            <div>
              <h3 class="font-semibold text-navy dark:text-text-dark mb-1">Vieni a conoscermi</h3>
              <p class="text-navy/70 dark:text-text-dark/70">Sceglieremo insieme la modalità di allenamento più adatta alle tue esigenze e disponibilità.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="w-10 h-10 bg-accent dark:bg-accent-dark text-white dark:text-navy-dark rounded-full flex items-center justify-center font-bold shrink-0">3</span>
            <div>
              <h3 class="font-semibold text-navy dark:text-text-dark mb-1">Iniziamo il percorso</h3>
              <p class="text-navy/70 dark:text-text-dark/70">Vieni ad allenarti con il programma su misura che evolverà con i tuoi progressi.</p>
            </div>
          </li>
        </ol>
        <a
          href={`${base}/contatti`}
          class="inline-block mt-8 bg-accent dark:bg-accent-dark text-white dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy dark:hover:bg-text-dark transition-colors"
        >
          Contattami ora
        </a>
      </div>
    </div>
  </Section>
</Layout>
