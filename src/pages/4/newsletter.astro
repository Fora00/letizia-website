---
import Layout from '../../layouts/LayoutV4.astro';
import Section from '../../components/Section.astro';
import SubstackPosts from '../../components/v2/SubstackPosts.astro';
import SubstackSignup from '../../components/v2/SubstackSignup.astro';

const version = Astro.url.pathname.split('/').find(s => /^\d+$/.test(s)) ?? '';
const base = `${import.meta.env.BASE_URL}${version}`;
---

<Layout
  title="Newsletter"
  description="Idee, consigli e riflessioni su movimento, salute e benessere. Leggi gli ultimi articoli dalla newsletter di Letizia Mancini."
>
  <!-- Hero -->
  <section class="bg-navy text-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 text-sage text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Newsletter
      </div>
      <h1 class="font-heading font-bold text-3xl md:text-5xl mb-4">Dalla newsletter</h1>
      <p class="text-white/70 text-lg max-w-xl mx-auto">
        Idee, consigli e riflessioni su movimento, salute e benessere — ogni settimana nella tua casella di posta.
      </p>
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-1.5 mt-8 text-sage/80 hover:text-sage text-sm transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Torna alla home
      </a>
    </div>
  </section>

  <!-- Posts -->
  <Section title="Ultimi articoli" centered>
    <SubstackPosts limit={9} showAllLink={true} />
  </Section>

  <!-- Subscribe CTA -->
  <Section bgColor="sage-light" centered>
    <SubstackSignup />
  </Section>
</Layout>
