---
import Layout from '../../layouts/LayoutV4.astro';
import Section from '../../components/Section.astro';

const version = Astro.url.pathname.split('/').find(s => /^\d+$/.test(s)) ?? '';
const base = `${import.meta.env.BASE_URL}${version}`;

const testimonials = [
  {
    quote: 'Ottima professionista, empatica e con una spiccata capacità di ascolto e di interazione; nel mio caso è riuscita a trovare il percorso individuale più adatto alle mie esigenze. Da consigliare.',
    author: "Serena P."
  },
  {
    quote: "Una professionista capace, in grado di trovare rapidamente il motivo del mio dolore alla spalla e prescrivermi un percorso di riabilitazione dal quale ho trovato — e sto trovando — grande giovamento. La consiglio caldamente a tutti!",
    author: "Simone M."
  },
  {
    quote: "A mio parere veramente brava, mi ha spiegato benissimo ogni tipo di esercizio che non capivo. È pure gentile e si vede che è una persona che conosce molto bene il suo ambito lavorativo. Io la consiglio molto anche perché non ho mai conosciuto persone gentili e che spiegano bene come lei.",
    author: "Sara G."
  },
  {
    quote: "La dottoressa Mancini si è dimostrata preparata e disponibile, in grado di consigliarmi e motivarmi in ogni passo del percorso intrapreso con lei! Non c'è altro da dire se non: \"Super Consigliata!\"",
    author: "Francesco F."
  },
  {
    quote: "Riscontrato professionalità e disponibilità. I risultati ci sono stati subito dopo i primi incontri. Consigliato.",
    author: "Sabrina D.S."
  },
  {
    quote: "Professionista pazzesca, non c'è paragone con tutti e tutte le professioniste che ho incontrato prima di lei. Adatta a qualsiasi condizione, iper-professionale ma allo stesso tempo alla mano ed empatica.",
    author: "Massimo Z."
  }
];
---

<Layout title="Dicono di me" description="Leggi le testimonianze di chi ha già scelto i miei servizi">
  <Section>
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        Dicono di me
      </h1>
      <p class="text-navy/70 dark:text-text-dark/70 text-lg">
        Le parole di chi ha già intrapreso un percorso con me.
      </p>
    </div>

    <!-- Masonry columns layout -->
    <div class="masonry-grid">
      {testimonials.map((testimonial) => (
        <article class="masonry-item bg-white dark:bg-sage-dark rounded-2xl p-6 shadow-sm border border-sage/20 dark:border-white/10 hover:shadow-md transition-shadow duration-200">
          <!-- Decorative quote mark -->
          <div class="font-heading text-6xl leading-none text-sage dark:text-sage/40 select-none mb-2" aria-hidden="true">
            &ldquo;
          </div>
          <p class="text-navy/85 dark:text-text-dark/85 leading-relaxed text-base mb-5">
            {testimonial.quote}
          </p>
          <p class="font-heading font-semibold text-accent dark:text-accent-dark">
            &mdash; {testimonial.author}
          </p>
        </article>
      ))}
    </div>

    <style>
      .masonry-grid {
        columns: 1;
        column-gap: 1.25rem;
      }
      @media (min-width: 640px) {
        .masonry-grid { columns: 2; }
      }
      @media (min-width: 1024px) {
        .masonry-grid { columns: 3; }
      }
      .masonry-item {
        break-inside: avoid;
        margin-bottom: 1.25rem;
        display: inline-block;
        width: 100%;
      }
    </style>
  </Section>

  <Section bgColor="sage-light" centered>
    <div class="max-w-2xl mx-auto">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-6">
        Sono la professionista che fa al caso tuo?
      </h2>
      <p class="text-navy/80 dark:text-text-dark/80 leading-relaxed mb-8">
        Vieni a conoscermi per scoprire come posso aiutarti a raggiungere i tuoi obiettivi.
      </p>
      <a
        href={`${base}/contatti`}
        class="inline-block bg-accent dark:bg-accent-dark text-white dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy dark:hover:bg-text-dark transition-colors"
      >
        Inizia il tuo percorso
      </a>
    </div>
  </Section>
</Layout>
