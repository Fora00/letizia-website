---
import Layout from '../../layouts/LayoutV4.astro';

const version = Astro.url.pathname.split('/').find(s => /^\d+$/.test(s)) ?? '';
const base = `${import.meta.env.BASE_URL}${version}`;
---

<Layout title="Pagina non trovata">
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center">
      <p class="font-heading font-bold text-8xl text-sage mb-4">404</p>
      <h1 class="font-heading font-bold text-2xl text-navy dark:text-text-dark mb-4">
        Pagina non trovata
      </h1>
      <p class="text-navy/70 dark:text-text-dark/70 mb-8 max-w-md mx-auto">
        La pagina che stai cercando non esiste o è stata spostata.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${base}/`}
          class="inline-block bg-accent dark:bg-accent-dark text-white dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy dark:hover:bg-text-dark transition-colors"
        >
          Torna alla home
        </a>
        <a
          href={`${base}/contatti`}
          class="inline-block bg-sage-light dark:bg-sage-dark text-navy dark:text-text-dark font-semibold px-8 py-4 rounded-full hover:bg-sage hover:text-white transition-colors"
        >
          Contattami
        </a>
      </div>
    </div>
  </div>
</Layout>
