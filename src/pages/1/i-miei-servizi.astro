---
import Layout from '../../layouts/LayoutV1.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';

const isGitHubPages = process.env.GITHUB_ACTIONS === 'true';
const ghBase =  isGitHubPages ? 'https://fora00.github.io/letizia-website' : 'https://letiziamancini.it';
const base = ghBase + '/' + Astro.url.pathname.split('/').filter(Boolean)[0];

const services = [
  {
    title: "Movimento adattato per condizioni croniche",
    description: "Programmi di esercizio fisico personalizzati per persone con patologie croniche stabilizzate (diabete, ipertensione, patologie cardiovascolari, ecc.).",
    icon: "💚"
  },
  {
    title: "Supporto per disturbi della nutrizione e dell'alimentazione",
    description: "Prendere consapevolezza del proprio corpo e muoversi in un contesto sicuro, guidato e senza giudizio.",
    icon: "🌱"
  },
  {
    title: "Gestione del dolore osteo-articolare",
    description: "Esercizi mirati per alleviare dolori muscolari e articolari (mal di schiena, cervicalgia, dolori alle spalle, ecc.) attraverso il movimento corretto e il rinforzo muscolare.",
    icon: "🦴"
  },
  {
    title: "Gravidanza e post-parto",
    description: "Esercizi sicuri e adattati per accompagnare ogni fase della maternità: dalla preparazione al parto al recupero post-partum.",
    icon: "🤰"
  },
  {
    title: "Terza età",
    description: "Programmi specifici per mantenere e migliorare la mobilità, l'equilibrio e l'autonomia. Prevenzione delle cadute e mantenimento della qualità di vita.",
    icon: "🌳"
  },
  {
    title: "Ricomposizione corporea",
    description: "Percorsi per chi desidera perdere peso, aumentare la massa muscolare o semplicemente migliorare la propria forma fisica in modo sano, graduale e sostenibile nel tempo.",
    icon: "⚡"
  },


];
---

<Layout title="I miei servizi" description="Scopri i servizi di chinesiologia clinica e personal training: movimento adattato, supporto DCA, dolore articolare, gravidanza e molto altro">
  <Section>
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-6">
        I miei servizi
      </h1>

    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {services.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </Section>

  <Section bgColor="sage-light" centered>
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-6">
        Non trovi quello che cerchi?
      </h2>
      <p class="text-navy/80 dark:text-text-dark/80 leading-relaxed mb-8">
        Ogni situazione è unica. Se hai dubbi o domande sul tuo caso specifico,
        contattami per una consulenza gratuita. Insieme valuteremo il percorso
        più adatto alle tue esigenze.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${base}/la-mia-proposta`}
          class="inline-block bg-white dark:bg-sage-dark text-navy dark:text-text-dark font-semibold px-8 py-4 rounded-full hover:bg-navy hover:text-white dark:hover:bg-accent-dark dark:hover:text-navy-dark transition-colors"
        >
          Scopri le proposte
        </a>
        <a
          href={`${base}/contatti`}
          class="inline-block bg-accent dark:bg-accent-dark text-white dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy dark:hover:bg-text-dark transition-colors"
        >
          Contattami
        </a>
      </div>
    </div>
  </Section>
</Layout>
