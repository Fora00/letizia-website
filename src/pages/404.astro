---
import Layout from '../layouts/LayoutV5.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Pagina non trovata">
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-16">
    <div class="text-center max-w-lg mx-auto">
      <p class="font-heading font-bold text-8xl text-sage mb-2">404</p>
      <h1 class="font-heading font-bold text-2xl text-navy dark:text-text-dark mb-3">
        Pagina non trovata
      </h1>
      <p class="text-navy/70 dark:text-text-dark/70 mb-8 leading-relaxed">
        La pagina che cerchi non esiste o è stata spostata. Ecco alcune destinazioni utili:
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-10">
        <a
          href={`${base}/`}
          class="inline-block bg-accent dark:bg-accent-dark text-white dark:text-navy-dark font-semibold px-7 py-3.5 rounded-full hover:bg-navy dark:hover:bg-text-dark transition-colors"
        >
          Home
        </a>
        <a
          href={`${base}/cosa-offro`}
          class="inline-block bg-sage-light dark:bg-surface-dark text-navy dark:text-text-dark font-semibold px-7 py-3.5 rounded-full hover:bg-sage hover:text-white transition-colors"
        >
          Servizi
        </a>
        <a
          href={`${base}/contatti`}
          class="inline-block bg-sage-light dark:bg-surface-dark text-navy dark:text-text-dark font-semibold px-7 py-3.5 rounded-full hover:bg-sage hover:text-white transition-colors"
        >
          Contattami
        </a>
      </div>
      <div class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm max-w-xs mx-auto text-left">
        {[
          { href: `${base}/chi-sono`, label: 'Chi sono' },
          { href: `${base}/dicono-di-me`, label: 'Testimonianze' },
          { href: `${base}/eventi`, label: 'Workshop & Corsi' },
          { href: `${base}/newsletter`, label: 'Newsletter' },
        ].map(link => (
          <a href={link.href} class="text-accent dark:text-accent-dark hover:underline font-medium">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
