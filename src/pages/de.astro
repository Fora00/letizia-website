---
import Layout from '../layouts/LayoutV5.astro';
import Section from '../components/v5/Section.astro';

// NOTE: Letizia does not speak German. This page exists for cross-border
// German-speaking visitors (Südtirol) and must never promise German-language
// sessions — the funnel routes to Italian/English contact. The copy still
// needs a professional translation review (see ROADMAP.md) since Letizia
// can't self-verify it the way she can for /en.

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = [
  {
    title: "Angepasste körperliche Aktivität",
    description: "Individuelle Trainingsprogramme für Menschen mit stabilen chronischen Erkrankungen wie Diabetes, Bluthochdruck oder Herz-Kreislauf-Erkrankungen, in Abstimmung mit Ihrem Arzt.",
  },
  {
    title: "Bewegung & Essstörungen",
    description: "Ein sicherer Weg ohne Druck, um eine gesunde Beziehung zur Bewegung wieder aufzubauen — in Abstimmung mit Ihrem Behandlungsteam.",
  },
  {
    title: "Gelenkschmerzen & Beweglichkeit",
    description: "Progressives Training, um Schmerzen im Bewegungsapparat zu reduzieren und sich im Alltag wieder sicherer zu bewegen.",
  },
  {
    title: "Körperliche Neuzusammensetzung",
    description: "Schrittweises, nachhaltiges Training zum Abnehmen oder Muskelaufbau — ohne Crash-Programme und ohne Vorher-Nachher-Druck.",
  },
];
---

<Layout
  title="Klinische Kinesiologin & Personal Trainerin in Trient und Rovereto"
  description="Letizia Mancini ist klinische Kinesiologin und Personal Trainerin in Trient und Rovereto (Trentino). Termine auf Italienisch oder Englisch, vor Ort oder online. Kostenloses 30-minütiges Erstgespräch."
  lang="de"
>
  <!-- Header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-white dark:bg-navy-dark text-accent dark:text-accent-dark font-semibold px-4 py-1.5 rounded-full text-sm mb-4">
        Deutsch
      </span>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        Klinische Kinesiologin in Trient &amp; Rovereto
      </h1>
      <p class="text-lg text-navy/70 dark:text-text-dark/70 max-w-2xl leading-relaxed">
        Ich bin Letizia Mancini, klinische Kinesiologin und Personal Trainerin. Ich habe einen
        European Master of Science in Health and Physical Activity und bin auf angepasste
        körperliche Aktivität für Menschen mit gesundheitlichen Einschränkungen spezialisiert.
        Ich arbeite in meinen Studios in Trient (Via Brescia 15) und Rovereto (Via Brione 39)
        oder online.
      </p>
    </div>
  </section>

  <!-- Language notice: honest funnel — no German-language sessions -->
  <Section>
    <div class="max-w-2xl mx-auto bg-sage-light dark:bg-surface-dark border-l-4 border-accent dark:border-accent-dark rounded-xl p-6">
      <h2 class="font-heading font-semibold text-lg text-navy dark:text-text-dark mb-2">
        Bitte beachten Sie
      </h2>
      <p class="text-navy/80 dark:text-text-dark/80 leading-relaxed">
        Die Beratung und die Trainingseinheiten finden auf <strong>Italienisch oder Englisch</strong> statt —
        ich spreche leider kein Deutsch. Wenn Sie mir schreiben möchten, verwenden Sie bitte
        Englisch oder Italienisch, damit ich Ihnen antworten kann.
      </p>
    </div>
  </Section>

  <!-- Services -->
  <Section bgColor="sage-light" title="Wobei ich helfen kann" centered>
    <div class="grid md:grid-cols-2 gap-6">
      {services.map((service) => (
        <div class="bg-white dark:bg-navy-dark rounded-2xl p-6">
          <h3 class="font-heading font-semibold text-lg text-navy dark:text-text-dark mb-2">
            {service.title}
          </h3>
          <p class="text-navy/70 dark:text-text-dark/70 text-sm leading-relaxed">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </Section>

  <!-- How it works -->
  <Section title="So funktioniert es" centered>
    <ol class="max-w-2xl mx-auto space-y-4 text-left">
      <li class="flex gap-4">
        <span class="shrink-0 w-8 h-8 rounded-full bg-accent dark:bg-accent-dark text-white dark:text-navy font-bold flex items-center justify-center" aria-hidden="true">1</span>
        <p class="text-navy/80 dark:text-text-dark/80"><strong class="text-navy dark:text-text-dark">Kostenloses 30-minütiges Erstgespräch</strong> — online oder vor Ort, unverbindlich. Wir sprechen (auf Englisch oder Italienisch) über Ihre Ziele und Ihre Gesundheitsgeschichte.</p>
      </li>
      <li class="flex gap-4">
        <span class="shrink-0 w-8 h-8 rounded-full bg-accent dark:bg-accent-dark text-white dark:text-navy font-bold flex items-center justify-center" aria-hidden="true">2</span>
        <p class="text-navy/80 dark:text-text-dark/80"><strong class="text-navy dark:text-text-dark">Bewertung</strong> — Bewegungsanalyse und, wo sinnvoll, Abstimmung mit Ihrem Arzt.</p>
      </li>
      <li class="flex gap-4">
        <span class="shrink-0 w-8 h-8 rounded-full bg-accent dark:bg-accent-dark text-white dark:text-navy font-bold flex items-center justify-center" aria-hidden="true">3</span>
        <p class="text-navy/80 dark:text-text-dark/80"><strong class="text-navy dark:text-text-dark">Individuelles Programm</strong> — Einzeltraining, kleine Gruppen oder Online-Coaching, in Ihrem Tempo.</p>
      </li>
      <li class="flex gap-4">
        <span class="shrink-0 w-8 h-8 rounded-full bg-accent dark:bg-accent-dark text-white dark:text-navy font-bold flex items-center justify-center" aria-hidden="true">4</span>
        <p class="text-navy/80 dark:text-text-dark/80"><strong class="text-navy dark:text-text-dark">Regelmäßige Kontrollen</strong> — wir passen das Programm an, wenn sich Ihr Körper und Ihr Leben verändern.</p>
      </li>
    </ol>
  </Section>

  <!-- CTA -->
  <Section bgColor="sage-light" centered>
    <div class="bg-navy text-white rounded-3xl p-8 md:p-12 text-center">
      <h2 class="font-heading font-bold text-2xl md:text-3xl mb-2">
        Sprechen wir — auf Englisch oder Italienisch
      </h2>
      <p class="text-white/80 mb-4 max-w-xl mx-auto">
        Buchen Sie ein kostenloses 30-minütiges Erstgespräch oder schreiben Sie mir eine E-Mail
        (bitte auf Englisch oder Italienisch). Ich antworte in der Regel innerhalb weniger Tage.
      </p>
      <p class="text-sm text-white/70 mb-8">30 Minuten · Unverbindlich · Per Videoanruf oder vor Ort</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://calendly.com/letiziamancini-chinesiologa/prenota_gratis?share_attribution=send_from_calendly_et_card"
          target="_blank"
          rel="noopener noreferrer"
          class="plausible-event-name=prenota-consulenza inline-block bg-sage text-navy font-semibold px-8 py-4 rounded-full hover:bg-white transition-colors"
        >
          Kostenloses Erstgespräch buchen
        </a>
        <a
          href="mailto:letiziamancini.chinesiologa@gmail.com"
          class="inline-block bg-transparent border-2 border-white text-white font-semibold px-8 py-4 rounded-full hover:bg-white hover:text-navy transition-colors"
        >
          E-Mail schreiben
        </a>
      </div>
      <p class="mt-8 text-sm text-white/60">
        <a href={`${base}/en`} class="underline hover:text-white">English version</a> ·
        <a href={`${base}/`} class="underline hover:text-white">Sito in italiano</a>
      </p>
    </div>
  </Section>
</Layout>
