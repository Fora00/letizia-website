---
import Layout from '../layouts/LayoutV5.astro';
import Section from '../components/v5/Section.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const siteUrl = Astro.site?.origin || "https://letiziamancini.it";

const testimonials = [
  {
    quote: 'Ottima professionista, empatica e con una spiccata capacità di ascolto e di interazione; nel mio caso è riuscita a trovare il percorso individuale più adatto alle mie esigenze. Da consigliare.',
    author: "Serena P."
  },
  {
    quote: "Una professionista capace, in grado di trovare rapidamente il motivo del mio dolore alla spalla e prescrivermi un percorso di riabilitazione dal quale ho trovato — e sto trovando — grande giovamento. La consiglio caldamente a tutti!",
    author: "Simone M."
  },
  {
    quote: "A mio parere veramente brava, mi ha spiegato benissimo ogni tipo di esercizio che non capivo. È pure gentile e si vede che è una persona che conosce molto bene il suo ambito lavorativo. Io la consiglio molto anche perché non ho mai conosciuto persone gentili e che spiegano bene come lei.",
    author: "Sara G."
  },
  {
    quote: "La dottoressa Mancini si è dimostrata preparata e disponibile, in grado di consigliarmi e motivarmi in ogni passo del percorso intrapreso con lei! Non c'è altro da dire se non: \"Super Consigliata!\"",
    author: "Francesco F."
  },
  {
    quote: "Riscontrato professionalità e disponibilità. I risultati ci sono stati subito dopo i primi incontri. Consigliato.",
    author: "Sabrina D.S."
  },
  {
    quote: "Professionista pazzesca, non c'è paragone con tutti e tutte le professioniste che ho incontrato prima di lei. Adatta a qualsiasi condizione, iper-professionale ma allo stesso tempo alla mano ed empatica.",
    author: "Massimo Z."
  }
];

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}/#business`,
  "name": "Letizia Mancini — Chinesiologa Clinica",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": String(testimonials.length),
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": testimonials.map(({ quote, author }) => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": author },
    "reviewBody": quote,
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
  }))
};
---

<Layout title="Dicono di me — Testimonianze e Recensioni" description="Leggi le recensioni di chi ha già scelto i servizi di Letizia Mancini, chinesiologa clinica e personal trainer a Trento e Rovereto.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
  <!-- Page header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-white dark:bg-navy-dark text-accent dark:text-accent-dark font-semibold px-4 py-1.5 rounded-full text-sm mb-4">
        Testimonianze
      </span>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        Dicono di me
      </h1>
      <p class="text-lg text-navy/70 dark:text-text-dark/70 max-w-2xl leading-relaxed">
        Le parole di chi ha già intrapreso un percorso con me.
      </p>
    </div>
  </section>

  <!-- Masonry testimonials -->
  <Section>
    <div class="masonry-grid">
      {testimonials.map((testimonial) => (
        <article aria-label={`Testimonianza di ${testimonial.author}`} class="masonry-item bg-sage-light dark:bg-surface-dark rounded-2xl p-6 hover:shadow-md transition-shadow duration-200">
          <div class="flex gap-0.5 mb-3" aria-label="5 stelle su 5">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 fill-[#facc15]" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <div class="font-heading text-6xl leading-none text-sage dark:text-sage/40 select-none mb-2" aria-hidden="true">
            &ldquo;
          </div>
          <p class="text-navy/85 dark:text-text-dark/85 leading-relaxed text-base mb-5">
            {testimonial.quote}
          </p>
          <p class="font-heading font-semibold text-accent dark:text-accent-dark">
            &mdash; {testimonial.author}
          </p>
        </article>
      ))}
    </div>

    <style>
      .masonry-grid {
        columns: 1;
        column-gap: 1.25rem;
      }
      @media (min-width: 640px) {
        .masonry-grid { columns: 2; }
      }
      @media (min-width: 1024px) {
        .masonry-grid { columns: 3; }
      }
      .masonry-item {
        break-inside: avoid;
        margin-bottom: 1.25rem;
        display: inline-block;
        width: 100%;
      }
    </style>
  </Section>

  <!-- CTA finale -->
  <Section bgColor="sage-light" centered>
    <div class="max-w-xl mx-auto text-center">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-4">
        Sei la prossima?
      </h2>
      <p class="text-navy/80 dark:text-text-dark/80 mb-8 leading-relaxed">
        Vieni a conoscermi per scoprire come posso aiutarti a raggiungere i tuoi obiettivi.
      </p>
      <a
        href={`${base}/contatti`}
        class="inline-block bg-accent dark:bg-accent-dark text-white dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy dark:hover:bg-text-dark transition-colors"
      >
        Inizia il tuo percorso
      </a>
    </div>
  </Section>
</Layout>
