---
import Layout from '../layouts/LayoutV5.astro';
import Section from '../components/v5/Section.astro';
import { getImage } from 'astro:assets';
import cosaOffroImgSrc from '../assets/images/personal-training-trento-rovereto.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cosaOffroImg = await getImage({ src: cosaOffroImgSrc, format: 'webp', width: 1400, quality: 80 });
const siteUrl = Astro.site?.origin || "https://letiziamancini.it";

const services = [
  {
    title: "Movimento adattato",
    description: "Programmi di esercizio fisico personalizzati per persone con patologie croniche stabilizzate (diabete, ipertensione, patologie cardiovascolari, ecc.).",
    iconPath: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
  },
    {
    title: "Ricomposizione corporea",
    description: "Percorsi per chi desidera perdere peso, aumentare la massa muscolare o semplicemente migliorare la propria forma fisica in modo sano, graduale e sostenibile nel tempo.",
    iconPath: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
  },
    {
    title: "Gestione del dolore",
    description: "Esercizi mirati per alleviare dolori muscolari e articolari (mal di schiena, cervicalgia, dolori alle spalle, ecc.) attraverso il movimento corretto e il rinforzo muscolare.",
    iconPath: "M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"
  },
  {
    title: "Gestione dello stress",
    description: "Programmi specifici per migliorare la salute del sistema nervoso autonomo e la risposta allo stress nel quotidiano.",
    iconPath: "M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
  },
  {
    title: "Supporto per disturbi della nutrizione e dell'alimentazione",
    description: "Un percorso per prendere consapevolezza del proprio corpo e muoversi in un contesto sicuro, guidato e senza giudizio.",
    iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  },
  {
    title: "Rieducazione posturale",
    description: "Un lavoro globale, dal piede al collo, mirato al riequilibrio muscolare e alla consapevolezza corporea, per ridurre tensioni, compensi e dolori nella vita quotidiana.",
    iconPath: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
  },

];

const formats = [
  {
    title: "Lezioni individuali",
    description: "Sessioni one-to-one cucite su misura sui tuoi bisogni, obiettivi e stile di vita.",
    iconPath: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
    highlight: "Massima personalizzazione",
    price: "€190",
    priceDetail: "4 lezioni",
    packages: "Lezione singola €55 · 8 lezioni €370 · 12 lezioni €520",
  },
  {
    title: "Piccoli gruppi",
    description: "La soluzione per chi cerca equilibrio tra attenzione personalizzata e dinamiche di gruppo.",
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
    highlight: "3-5 persone",
    price: "€80",
    priceDetail: "al mese (4 lezioni)",
    packages: "gruppi di 3–5 persone",
  },
  {
    title: "Coaching",
    description: "Scheda di allenamento personalizzata con controlli periodici per chi è lontano o preferisce allenarsi in autonomia.",
    iconPath: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
    highlight: "Ovunque tu sia",
    price: "€350",
    priceDetail: "semestrale (4 visite + scheda)",
    packages: "€600 annuale (8 visite + scheda)"
  }
];

const targets = [
  {
    description: "Cerchi un percorso costruito su misura, che tenga conto della tua storia e del tuo stile di vita per imparare a muoverti in sicurezza.",
    iconPath: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
  },
  {
    description: "Vuoi migliorare forza, autonomia e qualità della vita e ritrovare energia.",
    iconPath: "M13 10V3L4 14h7v7l9-11h-7z"
  },
  {
    description: "Vuoi allenarti in uno spazio privato, lontano dal caos della palestra.",
    iconPath: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteUrl}/cosa-offro/#service`,
  "name": "Chinesiologia clinica e personal training",
  "serviceType": services.map((s) => s.title),
  "provider": { "@id": `${siteUrl}/#business` },
  "areaServed": [
    { "@type": "Place", "name": "Trento" },
    { "@type": "Place", "name": "Rovereto" },
    { "@type": "Place", "name": "Online" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Formati di allenamento",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Lezione individuale singola",
        "price": 55,
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Pacchetto 4 lezioni individuali",
        "price": 190,
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Pacchetto 8 lezioni individuali",
        "price": 370,
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Pacchetto 12 lezioni individuali",
        "price": 520,
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Piccoli gruppi (3–5 persone), 4 lezioni al mese",
        "price": 80,
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Coaching online semestrale (4 visite + scheda)",
        "price": 350,
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Coaching online annuale (8 visite + scheda)",
        "price": 600,
        "priceCurrency": "EUR"
      }
    ]
  }
};
---

<Layout title="Servizi di Chinesiologia e Personal Training a Trento e Rovereto" description="Percorsi personalizzati a Trento e Rovereto per patologie croniche, DCA e dolore osteo-articolare. Lezioni individuali, piccoli gruppi e coaching online.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <!-- Page header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-white dark:bg-navy-dark text-accent dark:text-accent-dark font-semibold px-4 py-1.5 rounded-full text-sm mb-4">
        Servizi
      </span>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        Cosa offro
      </h1>
      <p class="text-lg text-navy/70 dark:text-text-dark/70 max-w-2xl leading-relaxed">
        Chinesiologia clinica e personal training a Trento, Rovereto e online: percorsi per patologie croniche, disturbi alimentari, dolori articolari e forma fisica.
      </p>
    </div>
  </section>

  <!-- Servizi -->
  <Section title="I miei servizi">
    <div class="grid md:grid-cols-2 gap-6">
      {services.map((service, i) => (
        <article class="fade-in-up bg-sage-light dark:bg-surface-dark rounded-2xl p-6 hover:shadow-md transition-all duration-200" style={`transition-delay: ${i * 80}ms`}>
          <div class="w-14 h-14 bg-white dark:bg-navy-dark rounded-xl flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.iconPath} />
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl text-navy dark:text-text-dark mb-3">{service.title}</h3>
          <p class="text-navy/70 dark:text-text-dark/70 leading-relaxed">{service.description}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- Formati — su sfondo immagine -->
  <Section
    centered
    class="relative overflow-hidden"
    style={`background-image: url('${cosaOffroImg.src}'); background-size: cover; background-position: center 30%;`}
  >
    <div class="absolute inset-0 bg-navy/75 -z-0"></div>
    <div class="relative z-10">
      <div class="mb-10 text-center">
        <h2 class="font-heading font-bold text-3xl md:text-4xl text-white mb-3">Come lavoro</h2>
        <p class="text-white/70 text-lg max-w-xl mx-auto">Scegli il formato più adatto al tuo stile di vita.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {formats.map((format, i) => (
          <article class="fade-in-up bg-white/95 dark:bg-navy-dark/90 rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-200 border border-white/20 flex flex-col backdrop-blur-sm" style={`transition-delay: ${i * 100}ms`}>
            <div class="flex items-start gap-4 mb-4">
              <div class="w-14 h-14 bg-sage-light dark:bg-surface-dark rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-7 h-7 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={format.iconPath} />
                </svg>
              </div>
              <div class="flex-1">
                <div class="flex flex-col gap-1 mb-1">
                  <h3 class="font-heading font-semibold text-lg text-navy dark:text-text-dark">
                    {format.title}
                  </h3>
                  <span class="self-start text-xs font-medium bg-accent/10 dark:bg-accent-dark/20 text-accent dark:text-accent-dark px-2 py-0.5 rounded-lg border-0 border-accent/30 dark:border-accent-dark/30">
                    {format.highlight}
                  </span>
                </div>
                <p class="text-navy/70 dark:text-text-dark/70 leading-relaxed text-sm">
                  {format.description}
                </p>
              </div>
            </div>
            <div class="mt-auto pt-4 border-t border-sage/20 dark:border-white/10">
              <div class="flex items-baseline gap-2 mb-1">
                <span class="font-heading font-bold text-2xl text-accent dark:text-accent-dark">{format.price}</span>
                <span class="text-sm text-navy/60 dark:text-text-dark/60">{format.priceDetail}</span>
              </div>
              <p class="text-sm font-medium text-navy/80 dark:text-text-dark/80">{format.packages}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Section>

  <!-- Sei nel posto giusto se... -->
  <Section bgColor="sage-light">
    <div class="max-w-2xl">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-10">
        Sei nel posto giusto se...
      </h2>
      <ul class="space-y-7">
        {targets.map((target, i) => (
          <li class="fade-in-up flex items-start gap-5" style={`transition-delay: ${i * 100}ms`}>
            <span class="w-7 h-7 rounded-full bg-accent dark:bg-accent-dark flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-white dark:text-navy-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <p class="text-navy/80 dark:text-text-dark/80 leading-relaxed text-lg">{target.description}</p>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-navy/70 dark:text-text-dark/70 leading-relaxed">
        Vuoi saperne di più? Leggi <a href={`${base}/chi-sono`} class="text-accent dark:text-accent-dark font-semibold hover:underline">chi sono e come lavoro</a> oppure <a href={`${base}/dicono-di-me`} class="text-accent dark:text-accent-dark font-semibold hover:underline">le testimonianze di chi ha già iniziato un percorso</a>.
      </p>
    </div>
  </Section>

  <!-- Come iniziare -->
  <Section>
    <div class="max-w-2xl">
      <h2 class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-8">
     Pronto a muoverti?
      </h2>
      <ol>
        <li class="flex gap-4">
          <div class="flex flex-col items-center">
            <span class="w-10 h-10 bg-accent dark:bg-accent-dark text-white dark:text-navy-dark rounded-full flex items-center justify-center font-bold shrink-0">1</span>
            <div class="w-px flex-1 bg-accent/30 dark:bg-accent-dark/30 mt-2"></div>
          </div>
          <div class="pb-8 pt-1">
            <h3 class="font-semibold text-navy dark:text-text-dark mb-1">Contattami</h3>
            <p class="text-navy/70 dark:text-text-dark/70">Raccontami la tua situazione e i tuoi obiettivi via form, email o prenota una call gratuita.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <div class="flex flex-col items-center">
            <span class="w-10 h-10 bg-accent dark:bg-accent-dark text-white dark:text-navy-dark rounded-full flex items-center justify-center font-bold shrink-0">2</span>
            <div class="w-px flex-1 bg-accent/30 dark:bg-accent-dark/30 mt-2"></div>
          </div>
          <div class="pb-8 pt-1">
            <h3 class="font-semibold text-navy dark:text-text-dark mb-1">Vieni a conoscermi</h3>
            <p class="text-navy/70 dark:text-text-dark/70">Sceglieremo insieme la modalità di allenamento più adatta alle tue esigenze e disponibilità.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <div class="flex flex-col items-center">
            <span class="w-10 h-10 bg-accent dark:bg-accent-dark text-white dark:text-navy-dark rounded-full flex items-center justify-center font-bold shrink-0">3</span>
          </div>
          <div class="pt-1">
            <h3 class="font-semibold text-navy dark:text-text-dark mb-1">Iniziamo il percorso</h3>
            <p class="text-navy/70 dark:text-text-dark/70 mb-6">Vieni ad allenarti con il programma su misura che evolverà con i tuoi progressi.</p>
            <a
              href={`${base}/contatti`}
              class="inline-block bg-accent dark:bg-accent-dark text-white dark:text-navy-dark font-semibold px-8 py-4 rounded-full hover:bg-navy dark:hover:bg-text-dark transition-colors"
            >
              Inizia il tuo percorso
            </a>
          </div>
        </li>
      </ol>
    </div>
  </Section>
</Layout>
