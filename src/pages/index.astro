---
import Layout from '../layouts/LayoutV5.astro';
import Section from '../components/v5/Section.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import SubstackSignup from '../components/v2/SubstackSignup.astro';
import { Image, getImage } from 'astro:assets';
import profileImgSrc from '../assets/images/profile.webp';
import heroImgSrc from '../assets/images/vertical-weight.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImg = await getImage({ src: heroImgSrc, format: 'webp', width: 1400, quality: 80 });

const stats = [
  {
    value: "5+",
    label: "anni di esperienza",
    iconPath: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
  },
  {
    value: "100+",
    label: "clienti seguiti",
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
  },

];

const services = [

  {
    title: "Movimento adattato",
    description: "Programmi di esercizio fisico personalizzati per persone con patologie croniche stabilizzate (diabete, ipertensione, patologie cardiovascolari, ecc.).",
    iconPath: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
    badge: "Patologie croniche",
    href: `${base}/cosa-offro`
  },
  {
    title : "Ricomposizione corporea",
    description : "Percorso per chi desidera perdere peso, aumentare la massa muscolare o semplicemente migliorare la propria forma fisica in modo sano, graduale e sostenibile nel tempo.",
    iconPath : "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    badge : "Fitness e salute",
    href: `${base}/cosa-offro`  
  },

];

const faqs = [
  {
    question: "Per chi sono i tuoi servizi?",
    answer: "I miei servizi sono pensati per persone di tutte le età e condizioni fisiche. Mi rivolgo in particolare a chi ha esigenze di salute specifiche, come patologie croniche, disturbi del comportamento alimentare o dolori osteoarticolari."
  },
  {
    question: "Come prenoto una consulenza gratuita?",
    answer: "Puoi prenotare direttamente tramite Calendly con il pulsante \"Prenota gratis\", oppure contattarmi via email o attraverso il modulo nella pagina Contatti."
  },
  {
    question: "Quanto durano le sessioni?",
    answer: "Le sessioni individuali durano solitamente 50–60 minuti. Per i piccoli gruppi e le lezioni collettive la durata può variare in base al programma concordato."
  },
  {
    question: "Lavori con persone che hanno condizioni mediche particolari?",
    answer: "Sì, sono specializzata in Attività Fisica Adattata. Lavoro a stretto contatto con il tuo medico curante per strutturare un percorso sicuro ed efficace, rispettando le tue specifiche esigenze di salute."
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer }
  }))
};
---

<Layout
  title="Chinesiologa Clinica e Personal Trainer in Trentino"
  description="Letizia Mancini — Chinesiologa clinica e personal trainer a Trento e Rovereto. Percorsi personalizzati per patologie croniche, DCA, dolore articolare. Anche online."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroImg.src} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Hero: same layout/dimensions as v4 but white overlay (non blu) and navy ring on profile -->
  <section
    id="hero-section"
    class="relative overflow-hidden min-h-[280px] md:min-h-[480px] max-h-[340px] md:max-h-[560px]"
    style={`background-image: url('${heroImg.src}'); background-size: cover; background-position: right 0%;`}
  >
    <!-- Mobile: dark overlay for text legibility -->
    <div class="absolute inset-0 block md:hidden" style="background: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 60%, rgba(0,0,0,0) 100%);"></div>
    <!-- Desktop (light): gradient fade left-to-right -->
    <div class="absolute inset-0 hidden md:block dark:hidden" style="background: linear-gradient(to right, rgba(255,255,255,1) 20%, rgba(255,255,255,0) 75%);"></div>
    <!-- Desktop (dark): gradient fade left-to-right -->
    <div class="absolute inset-0 hidden md:dark:block" style="background: linear-gradient(to right, rgba(7,25,45,1) 20%, rgba(7,25,45,0) 75%);"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
      <div class="max-w-xl">
        <h1 class="font-heading font-bold text-4xl md:text-5xl lg:text-6xl text-white md:text-navy dark:text-text-dark mb-4 md:mb-6 leading-tight [text-shadow:0_1px_6px_rgba(0,0,0,0.45)] md:[text-shadow:none]">
          Letizia Mancini
        </h1>
        <p class="text-base md:text-xl text-white/90 md:text-navy/75 dark:text-text-dark/80 mb-5 md:mb-8 leading-relaxed [text-shadow:0_1px_4px_rgba(0,0,0,0.4)] md:[text-shadow:none]">
Specialista dell'esercizio fisico per la salute.  Allenamenti cuciti su misura per tutte le esigenze.
        </p>
        <a
          href={`${base}/contatti`}
          class="inline-block bg-accent text-white font-semibold px-8 py-4 rounded-full hover:bg-navy hover:text-white transition-colors"
        >
          Inizia il tuo percorso
        </a>
      </div>
    </div>

    <!-- Fixed profile "patatellina" with navy ring — hidden on mobile -->
    <div id="fixed-profile" class="fixed bottom-0 right-0 z-50 pointer-events-none">
      <a href={`${base}/chi-sono`} class="block group pointer-events-auto">
        <Image
          src={profileImgSrc}
          alt="Ritratto della chinesiologa Letizia Mancini"
          width={650}
          height={640}
          class="h-48 sm:h-64 md:h-80 w-auto object-cover rounded-t-2xl transition-transform group-hover:scale-105 origin-bottom"
        />
      </a>
    </div>
  </section>

  <style is:global>
    @media (max-width: 639px) {
      #fixed-profile.profile-hidden { display: none; }
      #hero-section { background-position: center top !important; }
    }
    #fixed-profile.footer-in-view { display: none; }
  </style>

  <script>
    const hero = document.getElementById('hero-section');
    const fixed = document.getElementById('fixed-profile');
    const footer = document.querySelector('footer');

    if (hero && fixed) {
      const heroObserver = new IntersectionObserver(
        ([entry]) => { fixed.classList.toggle('profile-hidden', !entry.isIntersecting); },
        { threshold: 0 }
      );
      heroObserver.observe(hero);
    }

    if (footer && fixed) {
      const footerObserver = new IntersectionObserver(
        ([entry]) => { fixed.classList.toggle('footer-in-view', entry.isIntersecting); },
        { threshold: 0 }
      );
      footerObserver.observe(footer);
    }
  </script>

  <!-- Stats — sage-light, non blue -->
  <Section bgColor="sage-light">
    <div class="grid grid-cols-2 gap-8 text-center">
      {stats.map(({ value, label, iconPath }) => (
        <div>
          <div class="flex justify-center mb-2">
            <svg class="w-6 h-6 text-accent/50 dark:text-accent-dark/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPath} />
            </svg>
          </div>
          <p class="font-heading font-bold text-3xl md:text-4xl text-navy dark:text-text-dark mb-1">{value}</p>
          <p class="text-sm md:text-base text-navy/60 dark:text-text-dark/60">{label}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Aree di intervento -->
  <Section bgColor="white" title="Cosa offro" subtitle="Qualunque sia la tua situazione, posso aiutarti." centered>
    <div class="grid md:grid-cols-2 gap-6">
      {services.map((service, i) => (
        <a href={service.href} class="fade-in-up group block bg-sage-light dark:bg-surface-dark rounded-2xl p-6 hover:shadow-md transition-all duration-200" style={`transition-delay: ${i * 100}ms`}>
          <svg class="w-6 h-6 text-accent dark:text-accent-dark mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.iconPath} />
          </svg>
          <span class="text-xs font-semibold text-accent dark:text-accent-dark bg-accent/10 dark:bg-accent-dark/20 px-2 py-0.5 rounded-full">
            {service.badge}
          </span>
          <h3 class="font-heading font-semibold text-lg text-navy dark:text-text-dark mt-3 mb-2">
            {service.title}
          </h3>
          <p class="text-navy/70 dark:text-text-dark/70 text-sm leading-relaxed">
            {service.description}
          </p>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={`${base}/cosa-offro`} class="text-accent dark:text-accent-dark font-semibold hover:underline">
        Scopri tutti i servizi →
      </a>
    </div>
  </Section>

  <!-- CTA -->
  <Section centered>
    <div class="bg-navy text-white rounded-3xl p-8 md:p-12 text-center">
      <h2 class="font-heading font-bold text-2xl md:text-3xl mb-2">
        Il tuo primo passo verso il benessere
      </h2>
      <p class="text-white/80 mb-4 max-w-xl mx-auto">
        Prenota una consulenza gratuita e scopri il percorso più adatto a te.
      </p>
      <p class="text-sm text-white/50 mb-8">30 minuti · Nessun impegno · Video o in presenza</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://calendly.com/letiziamancini-chinesiologa/prenota_gratis?share_attribution=send_from_calendly_et_card"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-sage text-navy font-semibold px-8 py-4 rounded-full hover:bg-white transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Prenota gratis
        </a>
        <a
          href={`${base}/contatti`}
          class="inline-block bg-transparent border-2 border-white text-white font-semibold px-8 py-4 rounded-full hover:bg-white hover:text-navy transition-colors"
        >
          Contattami
        </a>
      </div>
    </div>
  </Section>

  <!-- Newsletter signup -->
  <Section bgColor="sage-light" centered>
    <SubstackSignup showPostsLink={true} />
  </Section>

  <!-- FAQ -->
  <Section title="Domande frequenti" centered>
    <FaqAccordion faqs={faqs} />
  </Section>
</Layout>
