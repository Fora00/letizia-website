---
import Layout from '../../layouts/LayoutV5.astro';
import Section from '../../components/v5/Section.astro';
import { events } from '../../data/events';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: event.slug } }));
}

const { slug } = Astro.params;
const event = events.find((e) => e.slug === slug)!;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pinPaths = [
  "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z",
  "M15 11a3 3 0 11-6 0 3 3 0 016 0z",
];
const videoPaths = [
  "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z",
];
const iconPaths = event.locationType === 'online' ? videoPaths : pinPaths;
---

<Layout title={event.title} description={event.description}>
  <!-- Page header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back link -->
      <a
        href={`${base}/eventi`}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-navy/60 dark:text-text-dark/60 hover:text-accent dark:hover:text-accent-dark transition-colors mb-6"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Tutti gli eventi
      </a>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-4">
        {event.tags.map((tag) => (
          <span class="inline-block bg-white dark:bg-navy-dark text-accent dark:text-accent-dark font-semibold px-3 py-1 rounded-full text-xs">
            {tag}
          </span>
        ))}
      </div>

      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-5">
        {event.title}
      </h1>

      <!-- Meta row -->
      <div class="flex flex-wrap gap-5 text-sm text-navy/70 dark:text-text-dark/70">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {event.date}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            {iconPaths.map((d) => (
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d} />
            ))}
          </svg>
          {event.location}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {event.duration}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          Max {event.maxParticipants} partecipanti
        </span>
      </div>
    </div>
  </section>

  <!-- Main content + sidebar -->
  <Section bgColor="white">
    <div class="grid lg:grid-cols-3 gap-12">
      <!-- Left: description + program -->
      <div class="lg:col-span-2 space-y-10">
        <!-- Description -->
        <div>
          <h2 class="font-heading font-bold text-2xl text-navy dark:text-text-dark mb-4">Di cosa si tratta</h2>
          <p class="text-navy/80 dark:text-text-dark/80 leading-relaxed text-lg">
            {event.fullDescription}
          </p>
        </div>

        <!-- Program -->
        <div>
          <h2 class="font-heading font-bold text-2xl text-navy dark:text-text-dark mb-6">Programma</h2>
          <ol class="space-y-4">
            {event.program.map((step, i) => (
              <li class="flex gap-4">
                <div class="flex flex-col items-center">
                  <div class="w-8 h-8 rounded-full bg-accent/10 dark:bg-accent-dark/20 text-accent dark:text-accent-dark font-bold text-sm flex items-center justify-center shrink-0">
                    {i + 1}
                  </div>
                  {i < event.program.length - 1 && (
                    <div class="w-px flex-1 bg-sage/30 dark:bg-white/10 mt-1" />
                  )}
                </div>
                <div class="pb-4">
                  <span class="text-xs font-semibold text-accent dark:text-accent-dark uppercase tracking-wide">{step.time}</span>
                  <p class="font-medium text-navy dark:text-text-dark mt-0.5">{step.label}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <!-- Right: pricing card + CTA -->
      <div class="space-y-4">
        <!-- Pricing card -->
        <div class="bg-sage-light dark:bg-surface-dark rounded-2xl p-6 transition-colors duration-200 sticky top-24">
          <span class="inline-block bg-navy/10 dark:bg-white/10 text-navy/60 dark:text-text-dark/60 text-xs font-semibold px-3 py-1 rounded-full mb-4">
            Prossimamente
          </span>
          <p class="font-heading font-bold text-3xl text-navy dark:text-text-dark mb-1">{event.price}</p>
          <p class="text-sm text-navy/60 dark:text-text-dark/60 mb-6">{event.duration}</p>

          <ul class="space-y-3 mb-6">
            <li class="flex items-center gap-2 text-sm text-navy/80 dark:text-text-dark/80">
              <svg class="w-4 h-4 text-accent dark:text-accent-dark shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {event.location}
            </li>
            <li class="flex items-center gap-2 text-sm text-navy/80 dark:text-text-dark/80">
              <svg class="w-4 h-4 text-accent dark:text-accent-dark shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Max {event.maxParticipants} partecipanti
            </li>
            <li class="flex items-center gap-2 text-sm text-navy/80 dark:text-text-dark/80">
              <svg class="w-4 h-4 text-accent dark:text-accent-dark shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Materiali inclusi
            </li>
          </ul>

          <a
            href={`${base}/contatti`}
            class="block w-full text-center bg-accent dark:bg-accent-dark text-white dark:text-navy font-semibold px-6 py-3 rounded-xl hover:opacity-90 transition-opacity"
          >
            Contattami per iscriverti
          </a>
          <p class="mt-3 text-xs text-center text-navy/50 dark:text-text-dark/50">
            Le iscrizioni apriranno presto
          </p>
        </div>
      </div>
    </div>
  </Section>
</Layout>
