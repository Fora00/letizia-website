---
import Layout from '../../../layouts/LayoutV5.astro';
import Section from '../../../components/v5/Section.astro';
import SubstackSignup from '../../../components/v2/SubstackSignup.astro';
import { events } from '../../../data/events';

const version = Astro.url.pathname.split('/').find(s => /^\d+$/.test(s)) ?? '';
const base = `${import.meta.env.BASE_URL}${version}`;

const pinPaths = [
  "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z",
  "M15 11a3 3 0 11-6 0 3 3 0 016 0z",
];
const videoPaths = [
  "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z",
];
---

<Layout title="Eventi" description="Workshop, corsi e newsletter di Letizia Mancini — kinesiologia, movimento e benessere">
  <!-- Page header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-white dark:bg-navy-dark text-accent dark:text-accent-dark font-semibold px-4 py-1.5 rounded-full text-sm mb-4">
        Eventi
      </span>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        Workshop & Newsletter
      </h1>
      <p class="text-lg text-navy/70 dark:text-text-dark/70 max-w-2xl leading-relaxed">
        Corsi e workshop dal vivo o online per approfondire il movimento — e una newsletter settimanale per rimanere aggiornata.
      </p>
    </div>
  </section>

  <!-- Workshop & Corsi -->
  <Section title="Workshop & Corsi" subtitle="Prossimi appuntamenti in programma. Iscriviti alla newsletter per non perdere le date." bgColor="white">
    <div class="grid md:grid-cols-3 gap-6">
      {events.map((event) => (
        <a
          href={`${base}/eventi/${event.slug}`}
          class="group relative bg-sage-light dark:bg-surface-dark rounded-2xl p-6 flex flex-col gap-4 transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
        >
          <!-- Prossimamente badge -->
          <span class="absolute top-4 right-4 bg-navy/10 dark:bg-white/10 text-navy/60 dark:text-text-dark/60 text-xs font-semibold px-3 py-1 rounded-full">
            Prossimamente
          </span>

          <!-- Date pill -->
          <span class="inline-flex items-center gap-1.5 bg-accent/10 dark:bg-accent-dark/20 text-accent dark:text-accent-dark text-sm font-semibold px-3 py-1 rounded-full w-fit">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {event.date}
          </span>

          <!-- Title -->
          <h3 class="font-heading font-bold text-lg text-navy dark:text-text-dark leading-snug pr-20 group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
            {event.title}
          </h3>

          <!-- Location -->
          <p class="flex items-center gap-2 text-sm text-navy/60 dark:text-text-dark/60">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              {(event.locationType === 'online' ? videoPaths : pinPaths).map((d) => (
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d} />
              ))}
            </svg>
            {event.location}
          </p>

          <!-- Description -->
          <p class="text-sm text-navy/70 dark:text-text-dark/70 leading-relaxed flex-1">
            {event.description}
          </p>

          <!-- CTA -->
          <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-accent dark:text-accent-dark group-hover:underline">
            Scopri di più
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </Section>

  <!-- Newsletter -->
  <Section bgColor="sage-light" centered>
    <SubstackSignup showPostsLink={true} />
  </Section>
</Layout>
