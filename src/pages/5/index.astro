---
import Layout from '../../layouts/LayoutV5.astro';
import Section from '../../components/v5/Section.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import SubstackSignup from '../../components/v2/SubstackSignup.astro';

const version = Astro.url.pathname.split('/').find(s => /^\d+$/.test(s)) ?? '';
const base = `${import.meta.env.BASE_URL}${version}`;

const stats = [
  {
    value: "5+",
    label: "anni di esperienza",
    iconPath: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
  },
  {
    value: "100+",
    label: "clienti seguiti",
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
  },
  {
    value: "3",
    label: "specializzazioni",
    iconPath: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
  },
];

const services = [
  {
    title: "Movimento adattato",
    description: "Per condizioni croniche stabilizzate come diabete, ipertensione, patologie cardiovascolari.",
    iconPath: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
    badge: "Patologie croniche",
    href: `${base}/cosa-offro`
  },
  {
    title: "Supporto DCA",
    description: "Accompagnamento motorio delicato per disturbi del comportamento alimentare.",
    iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    badge: "Approccio delicato",
    href: `${base}/cosa-offro`
  },
  {
    title: "Dolore osteo-articolare",
    description: "Esercizi mirati per mal di schiena, cervicalgia, dolori articolari.",
    iconPath: "M13 10V3L4 14h7v7l9-11h-7z",
    badge: "Riabilitazione",
    href: `${base}/cosa-offro`
  }
];

const previewTestimonials = [
  {
    quote: 'Ottima professionista, empatica e con una spiccata capacità di ascolto e di interazione; nel mio caso è riuscita a trovare il percorso individuale più adatto alle mie esigenze. Da consigliare.',
    author: "Serena P."
  },
  {
    quote: "Una professionista capace, in grado di trovare rapidamente il motivo del mio dolore alla spalla e prescrivermi un percorso di riabilitazione dal quale ho trovato grande giovamento. La consiglio caldamente!",
    author: "Simone M."
  },
  {
    quote: "Professionista pazzesca, non c'è paragone con tutte le professioniste che ho incontrato prima di lei. Iper-professionale ma allo stesso tempo alla mano ed empatica.",
    author: "Massimo Z."
  }
];

const faqs = [
  {
    question: "Per chi sono i tuoi servizi?",
    answer: "I miei servizi sono pensati per persone di tutte le età e condizioni fisiche. Mi rivolgo in particolare a chi ha esigenze di salute specifiche, come patologie croniche, disturbi del comportamento alimentare o dolori osteoarticolari."
  },
  {
    question: "Come prenoto una consulenza gratuita?",
    answer: "Puoi prenotare direttamente tramite Calendly con il pulsante \"Prenota gratis\", oppure contattarmi via email o attraverso il modulo nella pagina Contatti."
  },
  {
    question: "Quanto durano le sessioni?",
    answer: "Le sessioni individuali durano solitamente 50–60 minuti. Per i piccoli gruppi e le lezioni collettive la durata può variare in base al programma concordato."
  },
  {
    question: "Lavori con persone che hanno condizioni mediche particolari?",
    answer: "Sì, sono specializzata in Attività Fisica Adattata. Lavoro a stretto contatto con il tuo medico curante per strutturare un percorso sicuro ed efficace, rispettando le tue specifiche esigenze di salute."
  },
];
---

<Layout title="Home">
  <!-- Hero: same layout/dimensions as v4 but white overlay (non blu) and navy ring on profile -->
  <section
    id="hero-section"
    class="relative overflow-hidden min-h-[280px] md:min-h-[480px] max-h-[340px] md:max-h-[560px]"
    style={`background-image: url('${import.meta.env.BASE_URL}images/vertical-weight.jpg'); background-size: cover; background-position: right 0%;`}
  >
    <!-- Smooth white fade: opaque on left where text sits, gradual transition to transparent -->
    <div class="absolute inset-0 dark:hidden" style="background: linear-gradient(to right, rgba(255,255,255,1) 15%, rgba(255,255,255,0) 70%);"></div>
    <div class="absolute inset-0 hidden dark:block" style="background: linear-gradient(to right, rgba(10,22,40,1) 15%, rgba(10,22,40,0) 70%);"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
      <div class="max-w-xl">
        <h1 class="font-heading font-bold text-4xl md:text-5xl lg:text-6xl text-navy dark:text-text-dark mb-4 md:mb-6 leading-tight">
          Letizia Mancini
        </h1>
        <p class="text-base md:text-xl text-navy/75 dark:text-text-dark/80 mb-5 md:mb-8 leading-relaxed">
          Chinesiologa clinica e personal trainer in Trentino-Alto Adige. Ti accompagno in un percorso personalizzato verso il benessere fisico, anche online.
        </p>
        <a
          href={`${base}/contatti`}
          class="inline-block bg-accent text-white font-semibold px-8 py-4 rounded-full hover:bg-navy hover:text-white transition-colors"
        >
          Inizia il tuo percorso
        </a>
      </div>
    </div>

    <!-- Fixed profile "patatellina" with navy ring — hidden on mobile -->
    <div id="fixed-profile" class="fixed bottom-0 right-0 z-50 pointer-events-none">
      <a href={`${base}/chi-sono`} class="block group pointer-events-auto">
        <img
          src={`${import.meta.env.BASE_URL}images/profile.webp`}
          alt="Ritratto della chinesiologa Letizia Mancini"
          class="h-48 sm:h-64 md:h-80 w-auto object-cover rounded-t-2xl ring-4 ring-navy dark:ring-accent-dark transition-transform group-hover:scale-105 origin-bottom"
        />
      </a>
    </div>
  </section>

  <style is:global>
    @media (max-width: 639px) {
      #fixed-profile.profile-hidden { display: none; }
      #hero-section { background-position: center top !important; }
    }
  </style>

  <script>
    const hero = document.getElementById('hero-section');
    const fixed = document.getElementById('fixed-profile');
    if (hero && fixed) {
      const observer = new IntersectionObserver(
        ([entry]) => { fixed.classList.toggle('profile-hidden', !entry.isIntersecting); },
        { threshold: 0 }
      );
      observer.observe(hero);
    }
  </script>

  <!-- Stats — sage-light, non blue -->
  <Section bgColor="sage-light">
    <div class="grid grid-cols-3 gap-8 text-center">
      {stats.map(({ value, label, iconPath }) => (
        <div>
          <div class="flex justify-center mb-2">
            <svg class="w-6 h-6 text-accent/50 dark:text-accent-dark/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPath} />
            </svg>
          </div>
          <p class="font-heading font-bold text-3xl md:text-4xl text-navy dark:text-text-dark mb-1">{value}</p>
          <p class="text-sm md:text-base text-navy/60 dark:text-text-dark/60">{label}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Aree di intervento -->
  <Section bgColor="white" title="Aree di intervento" subtitle="Qualunque sia la tua situazione, posso aiutarti" centered>
    <div class="grid md:grid-cols-3 gap-6">
      {services.map((service) => (
        <a href={service.href} class="group block bg-sage-light dark:bg-surface-dark rounded-2xl p-6 hover:shadow-md transition-all duration-200">
          <svg class="w-6 h-6 text-accent dark:text-accent-dark mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.iconPath} />
          </svg>
          <span class="text-xs font-semibold text-accent dark:text-accent-dark bg-accent/10 dark:bg-accent-dark/20 px-2 py-0.5 rounded-full">
            {service.badge}
          </span>
          <h3 class="font-heading font-semibold text-lg text-navy dark:text-text-dark mt-3 mb-2">
            {service.title}
          </h3>
          <p class="text-navy/70 dark:text-text-dark/70 text-sm leading-relaxed">
            {service.description}
          </p>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={`${base}/cosa-offro`} class="text-accent dark:text-accent-dark font-semibold hover:underline">
        Scopri tutti i servizi →
      </a>
    </div>
  </Section>

  <!-- Dicono di me (preview) -->
  <Section bgColor="sage-light" title="Dicono di me" subtitle="Le parole di chi ha già intrapreso un percorso con me" centered>
    <div class="grid md:grid-cols-3 gap-6">
      {previewTestimonials.map((t) => (
        <article class="bg-white dark:bg-navy-dark rounded-2xl p-6 shadow-sm border border-sage/20 dark:border-white/10 flex flex-col">
          <!-- Small quote icon -->
          <svg class="w-5 h-5 text-sage dark:text-sage/50 mb-3 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M11.192 15.757c0-.88-.23-1.618-.69-2.217-.326-.412-.768-.683-1.327-.812-.55-.128-1.07-.137-1.54-.028-.16-.95.1-1.95.78-3 .53-.79 1.23-1.42 2.1-1.89L9.293 6c-.86.45-1.63 1.12-2.31 2.01-.68.89-1.18 1.9-1.5 3.01-.32 1.11-.34 2.21-.07 3.3.27 1.09.77 2 1.5 2.73.73.73 1.66 1.1 2.79 1.1.97 0 1.75-.33 2.35-1 .6-.67.9-1.5.9-2.49zm7.57 0c0-.88-.23-1.618-.69-2.217-.326-.42-.77-.69-1.327-.817-.56-.128-1.07-.137-1.54-.028-.16-.95.1-1.95.78-3 .53-.79 1.23-1.42 2.1-1.89l-.817-2.11c-.86.45-1.63 1.12-2.31 2.01-.68.89-1.18 1.9-1.5 3.01-.32 1.11-.34 2.21-.07 3.3.27 1.09.77 2 1.5 2.73.73.73 1.66 1.1 2.79 1.1.97 0 1.75-.33 2.35-1 .6-.67.9-1.5.9-2.49z"/>
          </svg>
          <p class="text-navy/80 dark:text-text-dark/80 leading-relaxed text-sm mb-4 flex-1">
            {t.quote}
          </p>
          <p class="font-heading font-semibold text-accent dark:text-accent-dark text-sm">
            &mdash; {t.author}
          </p>
        </article>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={`${base}/dicono-di-me`} class="text-accent dark:text-accent-dark font-semibold hover:underline">
        Leggi tutte le testimonianze →
      </a>
    </div>
  </Section>

  <!-- CTA -->
  <Section centered>
    <div class="bg-navy text-white rounded-3xl p-8 md:p-12 text-center">
      <h2 class="font-heading font-bold text-2xl md:text-3xl mb-2">
        Il tuo primo passo verso il benessere
      </h2>
      <p class="text-white/80 mb-4 max-w-xl mx-auto">
        Prenota una consulenza gratuita e scopri il percorso più adatto a te.
      </p>
      <p class="text-sm text-white/50 mb-8">30 minuti · Nessun impegno · Video o in presenza</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://calendly.com/letiziamancini-chinesiologa/prenota_gratis?share_attribution=send_from_calendly_et_card"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-sage text-navy font-semibold px-8 py-4 rounded-full hover:bg-white transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Prenota gratis
        </a>
        <a
          href={`${base}/contatti`}
          class="inline-block bg-transparent border-2 border-white text-white font-semibold px-8 py-4 rounded-full hover:bg-white hover:text-navy transition-colors"
        >
          Contattami
        </a>
      </div>
    </div>
  </Section>

  <!-- Newsletter signup -->
  <Section bgColor="sage-light" centered>
    <SubstackSignup showPostsLink={true} />
  </Section>

  <!-- FAQ -->
  <Section title="Domande frequenti" centered>
    <FaqAccordion faqs={faqs} />
  </Section>
</Layout>
