---
import Layout from '../../layouts/LayoutV5.astro';
import Section from '../../components/v5/Section.astro';
import { social } from '../../constants/socials';

const version = Astro.url.pathname.split('/').find(s => /^\d+$/.test(s)) ?? '';
const base = `${import.meta.env.BASE_URL}${version}`;
---

<Layout title="Contatti" description="Contattami per iniziare il tuo percorso di benessere">
  <!-- Page header -->
  <section class="bg-sage-light dark:bg-surface-dark py-12 md:py-16 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block bg-white dark:bg-navy-dark text-accent dark:text-accent-dark font-semibold px-4 py-1.5 rounded-full text-sm mb-4">
        Contatti
      </span>
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-navy dark:text-text-dark mb-4">
        Contattami
      </h1>
      <p class="text-lg text-navy/70 dark:text-text-dark/70 max-w-2xl leading-relaxed">
        Hai domande o vuoi iniziare un percorso insieme? Scrivimi o prenota una consulenza gratuita.
      </p>
    </div>
  </section>

  <!-- Form + info -->
  <Section>
    <div class="grid lg:grid-cols-5 gap-12">
      <!-- Contact Form -->
      <div class="lg:col-span-3">
        <div class="bg-sage-light dark:bg-surface-dark rounded-2xl p-8 transition-colors duration-200">
          <h2 class="font-heading font-semibold text-2xl text-navy dark:text-text-dark mb-6">
            Scrivimi un messaggio
          </h2>
          <iframe
            src={`https://tally.so/embed/3yxDLp?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
            loading="lazy"
            width="100%"
            height="300"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title="Contact Form"
            class="rounded-lg"
          ></iframe>
          <noscript>
            <p class="text-navy/70 dark:text-text-dark/70">
              Per utilizzare il form di contatto, abilita JavaScript nel tuo browser.
              In alternativa, scrivimi a <a href="mailto:info@letiziamancini.it" class="text-accent dark:text-accent-dark hover:underline">info@letiziamancini.it</a>
            </p>
          </noscript>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Calendly Booking -->
        <a
          href="https://calendly.com/letiziamancini-chinesiologa/prenota_gratis?share_attribution=send_from_calendly_et_card"
          target="_blank"
          rel="noopener noreferrer"
          class="block bg-accent dark:bg-accent-dark text-white dark:text-navy-dark rounded-2xl p-6 shadow-md dark:shadow-none hover:bg-navy dark:hover:bg-text-dark transition-colors group"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white/20 dark:bg-navy-dark/15 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-heading font-semibold text-lg mb-0.5">
                Consulenza gratuita
              </h3>
              <p class="text-white/80 dark:text-navy-dark/70 text-sm">
                Scegli il giorno e l'orario che preferisci
              </p>
            </div>
            <svg class="w-5 h-5 ml-auto group-hover:translate-x-1 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>

        <!-- Contact details -->
        <div class="bg-sage-light dark:bg-surface-dark rounded-2xl p-6 transition-colors duration-200">
          <h3 class="font-heading font-semibold text-xl text-navy dark:text-text-dark mb-5">
            Informazioni di contatto
          </h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 bg-white dark:bg-navy-dark rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-navy dark:text-text-dark text-sm">Email</p>
                <a href={`mailto:${social.mail}`} class="text-accent dark:text-accent-dark hover:underline text-sm">
                  {social.mail}
                </a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 bg-white dark:bg-navy-dark rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <a href={social.maps} target="_blank" rel="noopener noreferrer">
                <p class="font-medium text-navy dark:text-text-dark text-sm">Trento</p>
                <p class="text-navy/70 dark:text-text-dark/70 text-sm">Via Brescia, 15 — su appuntamento</p>
              </a>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 bg-white dark:bg-navy-dark rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-navy dark:text-text-dark text-sm">Rovereto</p>
                <p class="text-navy/70 dark:text-text-dark/70 text-sm">Via Brione, 39 — su appuntamento</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-9 h-9 bg-white dark:bg-navy-dark rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-navy dark:text-text-dark text-sm">Online</p>
                <p class="text-navy/70 dark:text-text-dark/70 text-sm">Sessioni in videochiamata</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Section>
</Layout>
