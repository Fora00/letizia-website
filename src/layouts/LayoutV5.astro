---
import '../styles/global.css';
import Navbar from '../components/v5/Navbar.astro';
import Footer from '../components/v5/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { social } from '../constants/socials';
import { locations } from '../constants/locations';
import { ogPages } from '../data/og-pages';
import { alternates, parsePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description,
  image,
  noindex = false,
  lang = "it"
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { route } = parsePath(Astro.url.pathname);
const t = useTranslations(lang as Lang);
const metaDescription = description ?? t('meta.default_description');
const hreflangs = alternates(route);
const siteUrl = Astro.site?.origin || "https://letiziamancini.it";
// Temporary GitHub Pages deployment: keep it out of search indexes so all
// SEO equity starts clean on letiziamancini.it. Flips off automatically once
// the build targets the real domain.
const isTempDomain = siteUrl.includes('fora00.github.io');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = `${title} | Letizia Mancini`;

const segmentLabels: Record<string, string> = {
  'chi-sono': t('meta.breadcrumb.chi_sono'),
  'cosa-offro': t('meta.breadcrumb.cosa_offro'),
  'contatti': t('meta.breadcrumb.contatti'),
  'dicono-di-me': t('meta.breadcrumb.dicono_di_me'),
  'newsletter': t('meta.breadcrumb.newsletter'),
  'privacy': t('meta.breadcrumb.privacy'),
};
const cleanPath = base ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const segments = cleanPath.split('/').filter(Boolean);
// Breadcrumbs follow the language prefix: /en/ is the English home, not a "page".
const crumbSegments = lang === 'it' ? segments : segments.slice(1);
const homeUrl = lang === 'it' ? `${siteUrl}/` : `${siteUrl}/${lang}/`;

// Per-page OG card generated at build time (see pages/og/[slug].png.ts);
// an explicit `image` prop wins, unknown paths fall back to the shared image.
const ogSlug = segments.join('-') || 'home';
const resolvedImage = image ?? (ogSlug in ogPages ? `${base}/og/${ogSlug}.png` : `${base}/images/og-image.jpg`);
const ogImageUrl = new URL(resolvedImage, siteUrl).href;
const breadcrumbSchema = crumbSegments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": homeUrl },
    ...crumbSegments.map((seg, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": segmentLabels[seg] ?? seg.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
      "item": `${homeUrl}${crumbSegments.slice(0, i + 1).join('/')}/`
    }))
  ]
} : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Letizia Mancini",
      "description": t('meta.website_description'),
      "inLanguage": lang === 'en' ? 'en-GB' : 'it-IT'
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Letizia Mancini",
      "jobTitle": t('meta.job_title'),
      "url": siteUrl,
      "email": "letiziamancini.chinesiologa@gmail.com",
      "alumniOf": [
        { "@type": "CollegeOrUniversity", "name": "Università degli Studi di Roma \"Foro Italico\"" }
      ],
      "hasCredential": [
        { "@type": "EducationalOccupationalCredential", "name": t('meta.degree_motor_sciences'), "educationalLevel": t('meta.degree_level_bachelor') },
        { "@type": "EducationalOccupationalCredential", "name": "European Master of Science in Health and Physical Activity", "educationalLevel": t('meta.degree_level_master') },
        { "@type": "EducationalOccupationalCredential", "name": t('meta.credential_hypopressive') },
        { "@type": "EducationalOccupationalCredential", "name": t('meta.credential_predictive') }
      ],
      "knowsAbout": t.group('meta.knows_about').map((k: { name: string }) => k.name),
      "sameAs": [
        "https://www.instagram.com/letiziamancini_chinesiologa",
        "https://www.facebook.com/profile.php?id=61555750393500",
        "https://www.linkedin.com/in/letizia-mancini-8a6163242"
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": `${siteUrl}/#business`,
      "name": t('meta.business_name'),
      "description": t('meta.business_description'),
      "url": siteUrl,
      "email": "letiziamancini.chinesiologa@gmail.com",
      "hasMap": social.maps,
      "priceRange": "€€",
      "address": locations.map((l) => ({
        "@type": "PostalAddress",
        "streetAddress": l.street,
        "addressLocality": l.city,
        "postalCode": l.postalCode,
        "addressRegion": l.region,
        "addressCountry": "IT"
      })),
      "areaServed": [
        ...locations.map((l) => ({ "@type": "Place", "name": l.city })),
        { "@type": "Place", "name": "Trentino-Alto Adige" },
        { "@type": "Place", "name": t('meta.area_online') }
      ],
      "serviceType": t.group('meta.service_types').map((k: { name: string }) => k.name),
      "sameAs": [
        "https://www.instagram.com/letiziamancini_chinesiologa",
        "https://www.facebook.com/profile.php?id=61555750393500",
        "https://www.linkedin.com/in/letizia-mancini-8a6163242"
      ]
    }
  ]
};
---

<!doctype html>
<html lang={lang} class="v5 scroll-smooth">
  <head>
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    {(noindex || isTempDomain) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    {hreflangs.length > 1 && hreflangs.map((alt) => <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, siteUrl).href} />)}
    {hreflangs.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(hreflangs.find((a) => a.lang === 'it')!.href, siteUrl).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={{ it: 'it_IT', en: 'en_GB' }[lang] ?? 'it_IT'} />
    <meta property="og:site_name" content="Letizia Mancini" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#000a2d" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000a2d" media="(prefers-color-scheme: dark)" />
    <link rel="dns-prefetch" href="https://calendly.com" />
    <link rel="dns-prefetch" href="https://tally.so" />
    <link rel="dns-prefetch" href="https://tadamove.substack.com" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Letizia Mancini — Newsletter" href={`${base}/rss.xml`} />
    {import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
      <script defer data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.tagged-events.outbound-links.js" is:inline></script>
    )}
    <title>{fullTitle}</title>
    <slot name="head" />
  </head>
  <body class="font-body text-navy bg-page dark:bg-navy-dark dark:text-text-dark min-h-screen flex flex-col transition-colors duration-200">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:bg-accent focus:text-navy focus:px-4 focus:py-2 focus:rounded-lg">
      {t('layout.skip_to_content')}
    </a>
    <Navbar />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
        }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));

      const btt = document.getElementById('back-to-top');
      window.addEventListener('scroll', () => {
        if (btt) btt.style.display = window.scrollY > 400 ? 'flex' : 'none';
      }, { passive: true });
      btt?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
    <CookieBanner />
    <button
      id="back-to-top"
      class="fixed bottom-8 left-5 z-40 w-10 h-10 bg-accent dark:bg-accent-dark text-navy dark:text-navy rounded-full shadow-lg hover:opacity-90 transition-opacity items-center justify-center"
      style="display: none"
      aria-label={t('layout.back_to_top')}
    >
      <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
      </svg>
    </button>
  </body>
</html>
